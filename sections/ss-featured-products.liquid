{% schema %}
{
  "name": "SS Featured Products",
  "tag": "section",
  "class": "ss-featured-products-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading & Copy"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "HANDPICKED FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Authentic Mithila Handcrafted Thekua"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Made with 100% Pure Desi Ghee, Traditional Wood Mold patterns & Zero Preservatives."
    },
    {
      "type": "header",
      "content": "Product Source & Limit"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection (Optional - defaults to All Products)"
    },
    {
