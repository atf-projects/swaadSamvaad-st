{% comment %}
  Section: Swaad Samvaad - Luxury Policy & General Page Template (sections/ss-main-page.liquid)
  Features:
  - Heritage Breadcrumbs & Mithila Auspicious Motifs.
  - Elegant Page Header with Eyebrow and Page Title.
  - Centered Premium Luxury Layout with high-readability typography.
  - Pure & Focused: Breadcrumbs, Title, and Page Content only.
{% endcomment %}

{{ 'ss-main-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_breadcrumbs = section.settings.show_breadcrumbs
-%}

<section
  id="ss-main-page-{{ section.id }}"
  class="ss-page-section"
  data-ss-main-page
  style="
    --ss-page-pad-top: {{ section.settings.padding_top | default: 24 }}px;
    --ss-page-pad-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
  "
>
  <div class="ss-page-container">

    {%- comment -%} 1. Breadcrumbs {%- endcomment -%}
    {%- if show_breadcrumbs -%}
      <nav class="ss-page-breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="ss-page-breadcrumbs__sep">❖</span>
        <span class="ss-page-breadcrumbs__current">{{ page.title | default: 'Page' }}</span>
      </nav>
    {%- endif -%}

    {%- comment -%} 2. Hero Header {%- endcomment -%}
    <div class="ss-page-hero">
      <h1 class="ss-page-title">
        {{ page.title | default: 'Swaad Samvaad Policy & Information' }}
      </h1>
    </div>

    {%- comment -%} 3. Main Content Container {%- endcomment -%}
    <main class="ss-page-main-content">
      <article class="ss-page-article ss-rte">
        {{ page.content }}
      </article>
    </main>

  </div>
</section>

{% schema %}
{
  "name": "SS Luxury Page",
  "tag": "section",
  "class": "ss-main-page-section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "SS Luxury Page"
    }
  ]
}
{% endschema %}
