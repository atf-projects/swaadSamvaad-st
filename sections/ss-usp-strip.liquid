{% comment %}
  Swaad Samvaad - USP Value Strip Section
  Luxury trust badges floating slightly over the hero banner or placed as a standalone bar.
  100% responsive, custom colors, icons, and Shopify font inheritance.
{% endcomment %}

{{ 'ss-usp-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}

<section
  id="ss-usp-strip-{{ sid }}"
  class="ss-usp-section {% if s.overlap_banner %}ss-usp-section--overlap{% endif %} ss-usp-section--{{ s.section_width }}"
  style="
    --ss-usp-bg: {{ s.card_background | default: '#FDFBF7' }};
    --ss-usp-border-color: {{ s.card_border_color | default: '#EBDDCF' }};
    --ss-usp-title-color: {{ s.title_color | default: '#2B1A10' }};
    --ss-usp-subtitle-color: {{ s.subtitle_color | default: '#7C6C60' }};
    --ss-usp-icon-color: {{ s.icon_color | default: '#B4552B' }};
    --ss-usp-pad-top: {{ s.padding_top | default: 0 }}px;
    --ss-usp-pad-bottom: {{ s.padding_bottom | default: 32 }}px;
  "
>
  <div class="ss-usp-container">
    <div class="ss-usp-card">
      <div class="ss-usp-grid">
        {%- for block in section.blocks -%}
          <div class="ss-usp-item" {{ block.shopify_attributes }}>
            <div class="ss-usp-icon-wrap">
              {%- case block.settings.icon -%}
                {%- when 'ghee' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                  </svg>
                {%- when 'shield-check' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                {%- when 'wheat' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
                    <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
                    <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
                    <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
                  </svg>
                {%- when 'box' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" class="ss-usp-svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {%- when 'custom-img' -%}
                  {%- if block.settings.custom_icon_img != blank -%}
                    <img src="{{ block.settings.custom_icon_img | image_url: width: 64 }}" alt="{{ block.settings.title | escape }}" class="ss-usp-custom-img" width="32" height="32" loading="lazy">
                  {%- endif -%}
              {%- endcase -%}
            </div>
            <div class="ss-usp-text">
              {%- if block.settings.title != blank -%}
                <h3 class="ss-usp-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="ss-usp-subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swaad USP Strip",
  "tag": "div",
  "class": "ss-usp-strip-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "overlap_banner",
      "label": "Overlap Hero Banner",
      "info": "Pulls this card up into the hero banner like shown in reference design.",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container Width",
      "options": [
        { "value": "boxed", "label": "Boxed Container" },
        { "value": "full", "label": "Full Width" }
      ],
      "default": "boxed"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#EBDDCF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#B4552B"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#2B1A10"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#7C6C60"
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ghee", "label": "Ghee Drop" },
            { "value": "shield-check", "label": "Shield Check (Refund)" },
            { "value": "wheat", "label": "Wheat / Handcrafted" },
            { "value": "box", "label": "Freshly Packed Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "custom-img", "label": "Custom Icon Image" }
          ],
          "default": "ghee"
        },
        {
          "type": "image_picker",
          "id": "custom_icon_img",
          "label": "Custom Icon Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pure Desi Ghee"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "No cheap oils or additives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swaad USP Strip",
      "blocks": [
        {
          "type": "usp_item",
          "settings": {
            "icon": "ghee",
            "title": "Pure Desi Ghee",
            "subtitle": "No cheap oils or additives"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "shield-check",
            "title": "100% Taste Refund",
            "subtitle": "Love it or get fully refunded"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "wheat",
            "title": "Handcrafted",
            "subtitle": "Authentic Mithila recipe"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "box",
            "title": "Freshly Packed",
            "subtitle": "Zero artificial preservatives"
          }
        }
      ]
    }
  ]
}
{% endschema %}
