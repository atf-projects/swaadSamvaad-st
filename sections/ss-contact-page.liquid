{% comment %}
  Section: Swaad Samvaad - Luxury Traditional Mithila Contact Page (sections/ss-contact-page.liquid)
  Features:
  - 100% Merchant Editable via Theme Customizer (Hero, Form, Contact Card, FAQs, Trust Pillars).
  - Balanced 2-Column Top Layout: Contact Form (Left) & Direct Support Card (Right).
  - Full-Width FAQ Section shifted to the bottom with dynamic customizable FAQ blocks.
  - Pure White Background (#FFFFFF) on all interactive cards.
  - Native Shopify Contact Form Integration with customizable alerts.
  - 100% Custom CSS & Fully Responsive (Desktop, Tablet, Mobile).
{% endcomment %}

{{ 'ss-contact-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ss-contact-page.js' | asset_url }}" defer="defer"></script>

<section
  id="ss-contact-page-{{ section.id }}"
  class="ss-contact-page"
  data-ss-contact-page
  style="
    --ss-contact-pad-top: {{ section.settings.padding_top | default: 24 }}px;
    --ss-contact-pad-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
  "
>
  <div class="ss-contact-container">

    {%- comment -%} 1. Breadcrumbs {%- endcomment -%}
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="ss-contact-breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_text | default: 'Home' }}</a>
        <span class="ss-contact-breadcrumbs__sep">❖</span>
        <span class="ss-contact-breadcrumbs__current">{{ section.settings.breadcrumb_current_text | default: 'Contact Us' }}</span>
      </nav>
    {%- endif -%}

    {%- comment -%} 2. Hero Header {%- endcomment -%}
    <div class="ss-contact-hero">
      {%- if section.settings.eyebrow_text != blank -%}
        <div class="ss-contact-eyebrow">
          <span class="ss-contact-eyebrow-line"></span>
          <span>{{ section.settings.eyebrow_text }}</span>
          <span class="ss-contact-eyebrow-line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="ss-contact-title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="ss-contact-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} 3. Main 2-Column Showcase (Form Left + Contact Card Right) {%- endcomment -%}
    <div class="ss-contact-main-grid">

      <!-- Left Column: Form -->
      <div class="ss-contact-form-wrap">
        <div class="ss-contact-form-header">
          {%- if section.settings.form_eyebrow != blank -%}
            <span class="ss-contact-form-eyebrow">{{ section.settings.form_eyebrow }}</span>
          {%- endif -%}
          <h2 class="ss-contact-form-title">{{ section.settings.form_title | default: 'Send Us a Message' }}</h2>
          {%- if section.settings.form_desc != blank -%}
            <p class="ss-contact-form-desc">{{ section.settings.form_desc }}</p>
          {%- endif -%}
        </div>

        {%- form 'contact', id: 'ss-main-contact-form', class: 'ss-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="ss-contact-alert ss-contact-alert--success" role="alert">
              <span class="ss-contact-alert__icon">✓</span>
              <div>
                <strong>{{ section.settings.form_success_title | default: 'Dhanyawaad! Message Sent Successfully.' }}</strong>
                <p>{{ section.settings.form_success_desc | default: 'Our Mithila team has received your note and will reach out within a few hours.' }}</p>
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="ss-contact-alert ss-contact-alert--error" role="alert">
              <span class="ss-contact-alert__icon">⚠</span>
              <div>
                <strong>Please check the highlighted fields:</strong>
                <p>{{ form.errors | default_errors }}</p>
              </div>
            </div>
          {%- endif -%}

          <!-- Name & Phone Row -->
          <div class="ss-contact-fields-row">
            <div class="ss-contact-field-group">
              <label class="ss-contact-label" for="ss-contact-name">{{ section.settings.label_name | default: 'Your Full Name *' }}</label>
              <input
                type="text"
                id="ss-contact-name"
                name="contact[name]"
                class="ss-contact-input"
                placeholder="{{ section.settings.placeholder_name | default: 'e.g. Priyanshu Jha' }}"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                required
              >
            </div>

            <div class="ss-contact-field-group">
              <label class="ss-contact-label" for="ss-contact-phone">{{ section.settings.label_phone | default: 'Phone Number / WhatsApp *' }}</label>
              <input
                type="tel"
                id="ss-contact-phone"
                name="contact[phone]"
                class="ss-contact-input"
                placeholder="{{ section.settings.placeholder_phone | default: 'e.g. +91 98765 43210' }}"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                required
              >
            </div>
          </div>

          <!-- Email & Order ID Row -->
          <div class="ss-contact-fields-row">
            <div class="ss-contact-field-group">
              <label class="ss-contact-label" for="ss-contact-email">{{ section.settings.label_email | default: 'Email Address *' }}</label>
              <input
                type="email"
                id="ss-contact-email"
                name="contact[email]"
                class="ss-contact-input"
                placeholder="{{ section.settings.placeholder_email | default: 'e.g. yourname@example.com' }}"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                required
              >
            </div>

            <div class="ss-contact-field-group">
              <label class="ss-contact-label" for="ss-contact-order-id">{{ section.settings.label_order_id | default: 'Order Number (Optional)' }}</label>
              <input
                type="text"
                id="ss-contact-order-id"
                name="contact[order_number]"
                class="ss-contact-input"
                placeholder="{{ section.settings.placeholder_order_id | default: 'e.g. #SS-1048' }}"
              >
            </div>
          </div>

          <!-- Message Textarea -->
          <div class="ss-contact-field-group">
            <label class="ss-contact-label" for="ss-contact-message">{{ section.settings.label_message | default: 'Your Message / Requirements *' }}</label>
            <textarea
              id="ss-contact-message"
              name="contact[body]"
              class="ss-contact-textarea"
              rows="5"
              placeholder="{{ section.settings.placeholder_message | default: 'Please share your questions, custom gift pack quantities, or delivery requirements here...' }}"
              required
            >{{ form.body }}</textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="ss-contact-submit-btn">
            <span>{{ section.settings.form_btn_text | default: 'Send Message to Rasoi ✦' }}</span>
          </button>
        {%- endform -%}
      </div>

      <!-- Right Column: Direct Contact Details Card (Pure White Background) -->
      <div class="ss-contact-info-card">
        <div class="ss-contact-info-header">
          <span class="ss-contact-info-icon">{{ section.settings.card_icon | default: '🪔' }}</span>
          <div>
            <h3>{{ section.settings.card_title | default: 'Direct Support & Rasoi Desk' }}</h3>
            <p>{{ section.settings.card_subtitle | default: 'Authentic Mithila Hospitality • Quick Assistance' }}</p>
          </div>
        </div>

        <div class="ss-contact-info-list">
          <!-- WhatsApp & Call -->
          {%- if section.settings.phone_number != blank -%}
            <div class="ss-contact-info-item">
              <div class="ss-contact-info-item__icon-wrap ss-contact-info-item__icon--whatsapp">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </div>
              <div class="ss-contact-info-item__body">
                <span class="ss-contact-info-item__label">{{ section.settings.phone_label | default: 'Call & WhatsApp Helpdesk' }}</span>
                <div class="ss-contact-info-item__actions">
                  <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}" class="ss-contact-info-item__val">
                    {{ section.settings.phone_number }}
                  </a>
                  {%- if section.settings.whatsapp_number != blank -%}
                    {%- assign encoded_wa_msg = section.settings.whatsapp_message | default: 'Namaste! I have an inquiry regarding Swaad Samvaad Thekua.' | url_encode -%}
                    <a
                      href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ encoded_wa_msg }}"
                      target="_blank"
                      rel="noopener"
                      class="ss-contact-info-item__wa-btn"
                    >
                      <span>{{ section.settings.whatsapp_btn_label | default: 'Chat on WhatsApp' }}</span>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}

          <!-- Support Email -->
          {%- if section.settings.email_address != blank -%}
            <div class="ss-contact-info-item">
              <div class="ss-contact-info-item__icon-wrap ss-contact-info-item__icon--email">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="ss-contact-info-item__body">
                <span class="ss-contact-info-item__label">{{ section.settings.email_label | default: 'Support & Gifting Desk' }}</span>
                <a href="mailto:{{ section.settings.email_address }}" class="ss-contact-info-item__val">
                  {{ section.settings.email_address }}
                </a>
                {%- if section.settings.email_badge != blank -%}
                  <span class="ss-contact-info-item__subtext">{{ section.settings.email_badge }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Kitchen & Office Address -->
          {%- if section.settings.kitchen_address != blank -%}
            <div class="ss-contact-info-item">
              <div class="ss-contact-info-item__icon-wrap ss-contact-info-item__icon--address">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="ss-contact-info-item__body">
                <span class="ss-contact-info-item__label">{{ section.settings.address_label | default: 'Heritage Mithila Rasoi (Kitchen HQ)' }}</span>
                <p class="ss-contact-info-item__address">
                  {{ section.settings.kitchen_address }}
                </p>
                {%- if section.settings.timings != blank -%}
                  <span class="ss-contact-info-item__timings">
                    <strong>Timings:</strong> {{ section.settings.timings }}
                  </span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        <!-- Optional Bottom Hospitality Note inside Contact Card -->
        {%- if section.settings.card_footer_note != blank -%}
          <div class="ss-contact-info-card__footer">
            <span>🪔</span>
            <p>{{ section.settings.card_footer_note }}</p>
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} 4. Full-Width FAQ Section (Shifted to Bottom) {%- endcomment -%}
    {%- if section.settings.show_faqs -%}
      <div class="ss-contact-faq-section">
        <div class="ss-contact-faq-header">
          {%- if section.settings.faq_eyebrow != blank -%}
            <div class="ss-contact-eyebrow">
              <span class="ss-contact-eyebrow-line"></span>
              <span>{{ section.settings.faq_eyebrow }}</span>
              <span class="ss-contact-eyebrow-line"></span>
            </div>
          {%- endif -%}
          <h2 class="ss-contact-faq-title">{{ section.settings.faq_heading | default: 'Frequently Asked Questions' }}</h2>
          {%- if section.settings.faq_subheading != blank -%}
            <p class="ss-contact-faq-subheading">{{ section.settings.faq_subheading }}</p>
          {%- endif -%}
        </div>

        <div class="ss-contact-faqs-grid" data-ss-contact-faqs>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'faq_item' -%}
                <details class="ss-contact-faq-item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="ss-contact-faq-summary">
                    <strong>{{ block.settings.question }}</strong>
                    <span class="ss-contact-faq-icon"></span>
                  </summary>
                  <div class="ss-contact-faq-content">
                    <p>{{ block.settings.answer }}</p>
                  </div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Default FAQs if merchant hasn't added blocks yet -->
            <details class="ss-contact-faq-item" open>
              <summary class="ss-contact-faq-summary">
                <strong>How fast is order dispatch and delivery?</strong>
                <span class="ss-contact-faq-icon"></span>
              </summary>
              <div class="ss-contact-faq-content">
                <p>Every order is prepared fresh on the day of baking in our Darbhanga rasoi and dispatched within 24 hours. Most metro cities receive delivery within 3-4 business days via express air courier.</p>
              </div>
            </details>

            <details class="ss-contact-faq-item">
              <summary class="ss-contact-faq-summary">
                <strong>Do you handle bulk festive & wedding orders?</strong>
                <span class="ss-contact-faq-icon"></span>
              </summary>
              <div class="ss-contact-faq-content">
                <p>Yes! We curate specialized gift hampers with personalized greeting tags and decorative Mithila art packaging for Chhath Puja, Diwali, corporate gifting, and weddings. Reach us via WhatsApp or phone for custom quotes.</p>
              </div>
            </details>

            <details class="ss-contact-faq-item">
              <summary class="ss-contact-faq-summary">
                <strong>What is the shelf life of the Thekua?</strong>
                <span class="ss-contact-faq-icon"></span>
              </summary>
              <div class="ss-contact-faq-content">
                <p>Our Desi Ghee Thekua stays crispy and fresh for up to <strong>60 days</strong> at room temperature in an airtight steel or glass jar. No refrigeration is needed.</p>
              </div>
            </details>

            <details class="ss-contact-faq-item">
              <summary class="ss-contact-faq-summary">
                <strong>Can I track my shipment in real-time?</strong>
                <span class="ss-contact-faq-icon"></span>
              </summary>
              <div class="ss-contact-faq-content">
                <p>Yes, as soon as your batch leaves our kitchen, you receive live WhatsApp & SMS tracking links with courier details (BlueDart/Delhivery).</p>
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 5. Mithila Purity Bottom Strip {%- endcomment -%}
    {%- if section.settings.show_purity_strip -%}
      <div class="ss-contact-purity-strip">
        <div class="ss-contact-purity-item">
          <div class="ss-contact-purity-icon">{{ section.settings.purity_1_icon | default: '🧈' }}</div>
          <div class="ss-contact-purity-text">
            <strong>{{ section.settings.purity_1_title | default: '100% Pure Desi Ghee Only' }}</strong>
            <p>{{ section.settings.purity_1_desc | default: 'Zero palm oil, authentic aroma' }}</p>
          </div>
        </div>
        <div class="ss-contact-purity-item">
          <div class="ss-contact-purity-icon">{{ section.settings.purity_2_icon | default: '🪵' }}</div>
          <div class="ss-contact-purity-text">
            <strong>{{ section.settings.purity_2_title | default: 'Wood-Carved Sancha' }}</strong>
            <p>{{ section.settings.purity_2_desc | default: 'Hand-pressed sacred motifs' }}</p>
          </div>
        </div>
        <div class="ss-contact-purity-item">
          <div class="ss-contact-purity-icon">{{ section.settings.purity_3_icon | default: '💬' }}</div>
          <div class="ss-contact-purity-text">
            <strong>{{ section.settings.purity_3_title | default: '24/7 WhatsApp Help' }}</strong>
            <p>{{ section.settings.purity_3_desc | default: 'Prompt assistance anytime' }}</p>
          </div>
        </div>
        <div class="ss-contact-purity-item">
          <div class="ss-contact-purity-icon">{{ section.settings.purity_4_icon | default: '📦' }}</div>
          <div class="ss-contact-purity-text">
            <strong>{{ section.settings.purity_4_title | default: 'Aroma-Lock Transit' }}</strong>
            <p>{{ section.settings.purity_4_desc | default: 'Zero breakage guarantee' }}</p>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Swaad Contact Page",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs & Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_text",
      "label": "Breadcrumb Home Label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current_text",
      "label": "Breadcrumb Current Label",
      "default": "Contact Us"
    },
    {
      "type": "header",
      "content": "Hero Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "✦ SWAAD SAMVAAD • MITHILA RASOI ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Get in Touch with Our Master Rasoiya"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "Have a query about our pure desi ghee delicacies, bulk festive gifting for Chhath Puja or weddings, or order status? We are here to serve you with authentic Mithila hospitality."
    },
    {
      "type": "header",
      "content": "Contact Form Settings"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Form Eyebrow Tag",
      "default": "✦ WRITE TO US ✦"
    },
    {
      "type": "text",
      "id": "form_title",
