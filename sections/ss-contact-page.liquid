{% comment %}
  Section: Swaad Samvaad - Luxury Traditional Mithila Contact Page (sections/ss-contact-page.liquid)
  Features:
  - Heritage Breadcrumbs & Auspicious Motifs.
  - 3 Quick Contact Info Cards (WhatsApp/Call, Darbhanga Rasoi HQ, Email Support).
  - 2-Column Contact Showcase (Smart Contact Form + FAQ & Mithila Hospitality Pledge).
  - Category / Subject Quick Select Chips.
  - Native Shopify Contact Form Integration with success/error alerts.
  - Interactive FAQ Accordions with smooth animated toggles.
  - 100% Custom CSS & Responsive (Desktop, Tablet, Mobile).
{% endcomment %}

{{ 'ss-contact-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ss-contact-page.js' | asset_url }}" defer="defer"></script>

<section
  id="ss-contact-page-{{ section.id }}"
  class="ss-contact-page"
  data-ss-contact-page
  style="
    --ss-contact-pad-top: {{ section.settings.padding_top | default: 24 }}px;
    --ss-contact-pad-bottom: {{ section.settings.padding_bottom | default: 72 }}px;
  "
>
  <div class="ss-contact-container">

    {%- comment -%} 1. Breadcrumbs {%- endcomment -%}
    <nav class="ss-contact-breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="ss-contact-breadcrumbs__sep">❖</span>
      <span class="ss-contact-breadcrumbs__current">Contact Us</span>
    </nav>

    {%- comment -%} 2. Hero Header {%- endcomment -%}
    <div class="ss-contact-hero">
      <div class="ss-contact-eyebrow">
        <span class="ss-contact-eyebrow-line"></span>
        <span>{{ section.settings.eyebrow_text | default: '✦ SWAAD SAMVAAD • MITHILA RASOI ✦' }}</span>
        <span class="ss-contact-eyebrow-line"></span>
      </div>

      <h1 class="ss-contact-title">
        {{ section.settings.heading | default: 'Get in Touch with Our Master Rasoiya' }}
      </h1>

      <p class="ss-contact-subtitle">
        {{ section.settings.subheading | default: 'Have a query about our pure desi ghee delicacies, bulk festive gifting for Chhath Puja or weddings, or order status? We are here to serve you with authentic Mithila hospitality.' }}
      </p>
    </div>

    {%- comment -%} 3. Quick Info Cards Strip {%- endcomment -%}
    <div class="ss-contact-cards-grid">
