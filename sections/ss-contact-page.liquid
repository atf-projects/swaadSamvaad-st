    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone Field Label",
      "default": "Phone Number / WhatsApp *"
    },
    {
      "type": "text",
      "id": "placeholder_phone",
      "label": "Phone Placeholder",
      "default": "e.g. +91 98765 43210"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email Field Label",
      "default": "Email Address *"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email Placeholder",
      "default": "e.g. yourname@example.com"
    },
    {
      "type": "text",
      "id": "label_order_id",
      "label": "Order ID Label",
      "default": "Order Number (Optional)"
    },
    {
      "type": "text",
      "id": "placeholder_order_id",
      "label": "Order ID Placeholder",
      "default": "e.g. #SS-1048"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message Field Label",
      "default": "Your Message / Requirements *"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Message Placeholder",
      "default": "Please share your questions, custom gift pack quantities, or delivery requirements here..."
    },
    {
      "type": "text",
      "id": "form_btn_text",
      "label": "Submit Button Label",
      "default": "Send Message to Rasoi ✦"
    },
    {
      "type": "text",
      "id": "form_success_title",
      "label": "Success Alert Title",
      "default": "Dhanyawaad! Message Sent Successfully."
    },
    {
      "type": "text",
      "id": "form_success_desc",
      "label": "Success Alert Description",
      "default": "Our Mithila team has received your note and will reach out within a few hours."
    },
    {
      "type": "header",
      "content": "Direct Support Card (Right Box)"
    },
    {
      "type": "text",
      "id": "card_icon",
      "label": "Card Icon / Emoji",
      "default": "🪔"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card Title",
      "default": "Direct Support & Rasoi Desk"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Card Subtitle",
      "default": "Authentic Mithila Hospitality • Quick Assistance"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone / WhatsApp Label",
      "default": "Call & WhatsApp Helpdesk"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+91 98765 43210"
    },
    {
      "type": "text",
      "id": "whatsapp_btn_label",
      "label": "WhatsApp Button Text",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Clean Number (No spaces/symbols)",
      "default": "919876543210",
      "info": "Used for wa.me link e.g. 919876543210"
