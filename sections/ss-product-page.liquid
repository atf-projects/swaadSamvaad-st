          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} 7. Interactive Review Modal Form {%- endcomment -%}
  <div class="ss-review-modal-overlay" data-ss-review-modal-overlay aria-hidden="true">
    <div class="ss-review-modal-container" role="dialog" aria-labelledby="ss-review-modal-heading" aria-modal="true">
      <div class="ss-review-modal-header">
        <div>
          <span class="ss-review-modal-eyebrow">✦ SWAAD SAMVAAD FEEDBACK ✦</span>
          <h3 id="ss-review-modal-heading" class="ss-review-modal-title">Write Your Verified Review</h3>
        </div>
        <button type="button" class="ss-review-modal-close" data-ss-close-review-modal aria-label="Close review modal">
          ✕
        </button>
      </div>

      <form class="ss-review-form" data-ss-review-form>
        <!-- Star Selector -->
        <div class="ss-review-form-group">
          <label class="ss-review-form-label">Overall Rating *</label>
          <div class="ss-review-star-selector" data-ss-star-selector>
            <button type="button" class="ss-star-rate-btn is-active" data-star-value="1" aria-label="1 Star">★</button>
            <button type="button" class="ss-star-rate-btn is-active" data-star-value="2" aria-label="2 Stars">★</button>
            <button type="button" class="ss-star-rate-btn is-active" data-star-value="3" aria-label="3 Stars">★</button>
            <button type="button" class="ss-star-rate-btn is-active" data-star-value="4" aria-label="4 Stars">★</button>
            <button type="button" class="ss-star-rate-btn is-active" data-star-value="5" aria-label="5 Stars">★</button>
          </div>
          <input type="hidden" name="rating" id="ss-review-rating-val" value="5" data-ss-rating-input>
        </div>

        <div class="ss-review-form-row">
          <div class="ss-review-form-group">
            <label class="ss-review-form-label" for="ss-review-author-name">Your Name *</label>
            <input
              type="text"
              id="ss-review-author-name"
              class="ss-review-input"
              placeholder="e.g. Priyanshu Jha"
              required
              data-ss-author-input
            >
          </div>
          <div class="ss-review-form-group">
            <label class="ss-review-form-label" for="ss-review-author-city">Your City / State *</label>
            <input
              type="text"
              id="ss-review-author-city"
              class="ss-review-input"
              placeholder="e.g. Patna, Bihar"
              required
              data-ss-city-input
            >
          </div>
        </div>

        <div class="ss-review-form-group">
          <label class="ss-review-form-label" for="ss-review-body">Your Review / Experience *</label>
          <textarea
            id="ss-review-body"
            class="ss-review-textarea"
            rows="4"
            placeholder="Tell us about the taste, aroma, crunchiness, and packaging..."
            required
            data-ss-body-input
          ></textarea>
        </div>

        <button type="submit" class="ss-review-submit-btn" data-ss-submit-review>
          <span>Submit Review ✦</span>
        </button>
      </form>
    </div>
  </div>

  {%- comment -%} 8. Mobile Sticky Bottom Add to Cart Bar {%- endcomment -%}
  <div class="ss-prod-sticky-bar" data-ss-sticky-bar aria-hidden="true">
    <div class="ss-prod-sticky-bar__inner">
      <div class="ss-prod-sticky-bar__info">
        {%- if featured_img != blank -%}
          <img src="{{ featured_img | image_url: width: 100, height: 100, crop: 'center' }}" alt="" class="ss-prod-sticky-bar__thumb" width="48" height="48">
        {%- else -%}
          <img src="{{ 'ss-thekua-crafting-art.jpg' | asset_url }}" alt="" class="ss-prod-sticky-bar__thumb" width="48" height="48">
        {%- endif -%}
        <div class="ss-prod-sticky-bar__text">
          <strong class="ss-prod-sticky-bar__title">{{ product.title | default: 'Pure Desi Ghee Thekua' }}</strong>
          <span class="ss-prod-sticky-bar__price" data-ss-sticky-price>{{ price | money }}</span>
        </div>
      </div>

      <button
        type="button"
        class="ss-prod-sticky-bar__btn"
        data-variant-id="{{ current_variant.id | default: 1 }}"
        data-ss-sticky-add
        aria-label="Add to Basket"
      >
        <span>+ ADD TO BASKET</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Swaad Single Product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "✦ SWAAD SAMVAAD MITHILA SPECIAL ✦"
    },
    {
      "type": "header",
      "content": "Related Delicacies"
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show Related Section",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Custom Collection",
      "info": "Leave blank to auto-detect this product's collection"
    },
    {
      "type": "range",
      "id": "related_products_count",
      "label": "Products to Show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "related_eyebrow",
      "label": "Related Eyebrow Text",
      "default": "✦ MORE SACRED DELICACIES ✦"
    },
    {
      "type": "text",
      "id": "related_title",
      "label": "Related Section Title",
      "default": "You May Also Relish"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 75
    }
  ]
}
{% endschema %}
