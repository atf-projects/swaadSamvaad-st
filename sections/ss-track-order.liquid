{% comment %}
  Section: Swaad Samvaad - Luxury Track Your Order Page (sections/ss-track-order.liquid)
  Features:
  - Heritage Breadcrumbs & Mithila Dispatch Motifs.
  - Dual Tracking Mode: Order ID + Phone/Email OR Courier AWB Tracking Number.
  - Quick Demo Chips for Instant Testing (#SS-9821, #SS-8743, #SS-3104).
  - Dynamic 5-Step Crafting & Delivery Visual Timeline with Pulse Animations.
  - Real-time Courier Status, Estimated Delivery Date, and Live Transit Activity Logs.
  - Package Contents Summary & 90-Day Freshness Guarantee Badge.
  - Direct 1-Click WhatsApp Support with Prefilled Order ID.
  - Tracking & Dispatch FAQ Accordion.
  - 100% Custom CSS, Responsive Across Mobile, Tablet & Desktop.
{% endcomment %}

{{ 'ss-track-order.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ss-track-order.js' | asset_url }}" defer="defer"></script>

<section
  id="ss-track-order-{{ section.id }}"
  class="ss-track-page"
  data-ss-track-page
  data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}"
  style="
    --ss-track-pad-top: {{ section.settings.padding_top | default: 25 }}px;
    --ss-track-pad-bottom: {{ section.settings.padding_bottom | default: 75 }}px;
  "
>
  <div class="ss-track-container">

    {%- comment -%} 1. Breadcrumbs {%- endcomment -%}
    <nav class="ss-track-breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="ss-track-breadcrumbs__sep">❖</span>
      <span class="ss-track-breadcrumbs__current">Track Order</span>
    </nav>

    {%- comment -%} 2. Hero Header {%- endcomment -%}
    <div class="ss-track-hero">
      <div class="ss-track-eyebrow">
        <span class="ss-track-eyebrow-line"></span>
        <span>{{ section.settings.eyebrow_text | default: '✦ SWAAD SAMVAAD DISPATCH & LOGISTICS ✦' }}</span>
        <span class="ss-track-eyebrow-line"></span>
      </div>
      <h1 class="ss-track-heading">{{ section.settings.heading | default: 'Track Your Sacred Mithila Parcel' }}</h1>
      <p class="ss-track-subheading">
        {{ section.settings.subheading | default: 'Enter your Order ID (with hashtag #, e.g. #1001) to check the live batch crafting and express courier status.' }}
      </p>
    </div>

    {%- comment -%} Customer Orders Real Data Embed {%- endcomment -%}
    {% if customer and customer.orders.size > 0 %}
      <script id="ss-customer-orders-data" type="application/json">
        [
          {% for order in customer.orders %}
            {
              "id": {{ order.name | json }},
              "order_number": {{ order.order_number | json }},
              "created_at": {{ order.created_at | date: "%b %d, %Y" | json }},
              "cancelled": {{ order.cancelled | default: false | json }},
              "cancelled_at": {{ order.cancelled_at | date: "%b %d, %Y" | json }},
              "cancel_reason": {{ order.cancel_reason_label | default: order.cancel_reason | json }},
              "financial_status": {{ order.financial_status | json }},
              "financial_status_label": {{ order.financial_status_label | json }},
              "fulfillment_status": {{ order.fulfillment_status | json }},
              "fulfillment_status_label": {{ order.fulfillment_status_label | default: 'Unfulfilled' | json }},
              "total_price": {{ order.total_price | money | json }},
              "order_status_url": {{ order.order_status_url | json }},
              "destination": {% if order.shipping_address %}{{ order.shipping_address.city | append: ', ' | append: order.shipping_address.province | append: ' (' | append: order.shipping_address.zip | append: ')' | json }}{% else %}"Verified Customer Address"{% endif %},
              "tracking_company": {{ order.fulfillments.first.tracking_company | default: order.line_items.first.fulfillment.tracking_company | default: '' | json }},
              "tracking_number": {{ order.fulfillments.first.tracking_number | default: order.line_items.first.fulfillment.tracking_number | default: '' | json }},
              "tracking_url": {{ order.fulfillments.first.tracking_url | default: order.line_items.first.fulfillment.tracking_url | default: '' | json }},
              "line_items": [
                {% for item in order.line_items %}
                  {
                    "title": {{ item.title | json }},
                    "quantity": {{ item.quantity | json }},
                    "price": {{ item.final_price | money | json }},
                    "image": {{ item.image | image_url: width: 120 | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      </script>
    {% endif %}

    {%- comment -%} 3. Single Order ID Tracking Input Card {%- endcomment -%}
    <div class="ss-track-card ss-track-input-card">
      <form class="ss-track-single-form" id="ss-order-track-form" data-track-form="single-order">
        <div class="ss-track-single-wrap">
          <label for="track-order-number" class="ss-track-single-label">
            Enter Order ID
          </label>
          <div class="ss-track-single-input-bar">
            <span class="ss-track-hash-badge">#</span>
            <input
              type="text"
              id="track-order-number"
              name="order_id"
              class="ss-track-single-input"
              placeholder="e.g. #1001 or 1001"
              required
              autocomplete="off"
              aria-label="Order ID with hashtag"
            >
            <button type="submit" class="ss-track-single-submit-btn" data-track-submit>
              <span class="ss-track-btn-text">Track Order</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <div class="ss-track-single-hint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span>Enter your Order ID with or without hashtag (e.g. <strong>#1001</strong>). You can find this in your order confirmation SMS or email.</span>
          </div>
        </div>
      </form>
    </div>

    {%- comment -%} 3.5. Wrong Order ID / Order Not Found State / Login Required State {%- endcomment -%}
    <div class="ss-track-card ss-track-error-card" id="ss-track-error" data-ss-track-error style="display: none;">
      <div class="ss-track-error-icon-box" data-error-icon-box>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
      </div>
      <div class="ss-track-error-content">
        <div class="ss-track-error-badge" data-error-badge>Wrong Order ID</div>
        <h3 class="ss-track-error-heading">
          <span data-error-heading-text>Order Not Found:</span> <span data-error-order-id>#0000</span>
        </h3>
        <p class="ss-track-error-desc" data-error-desc>
          No order found with this Order ID. Please make sure you have entered the correct Order ID (e.g. <strong>#1001</strong> or <strong>#SS-1001</strong>) as mentioned in your order confirmation SMS or email.
        </p>
        <div class="ss-track-error-actions">
          <a
            href="{{ routes.account_login_url }}"
            class="ss-track-error-login-btn"
            data-error-login-btn
            style="display: none;"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            <span>Log In to Your Account</span>
          </a>
          <a
            href="https://wa.me/917982006449"
            class="ss-track-error-wa-btn"
            data-error-wa-btn
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.27-2.42 5.82a8.19 8.19 0 0 1-5.82 2.42c-1.42 0-2.82-.37-4.06-1.07l-.29-.17-3.12.82.83-3.04-.19-.3a8.21 8.21 0 0 1-1.28-4.48c0-4.54 3.7-8.24 8.24-8.24zm4.51 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.79 2.74 4.34 3.84.61.26 1.08.42 1.45.54.61.19 1.17.17 1.61.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
            </svg>
            <span>Contact Support on WhatsApp</span>
          </a>
          <button type="button" class="ss-track-error-retry-btn" data-error-retry-btn>
            <span>Re-enter Order ID</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Dynamic Tracking Results Container -->
    <div class="ss-track-results" id="ss-track-results" data-ss-track-results style="display: none;">
      
      <!-- Special Status Notice (For Cancelled, Refunded, On Hold, or Pending Payment) -->
      <div class="ss-track-order-alert-box" data-order-alert-box style="display: none;">
        <div class="ss-track-order-alert-icon" data-alert-icon>⚠️</div>
        <div class="ss-track-order-alert-content">
          <strong class="ss-track-order-alert-title" data-alert-title>Order Cancelled</strong>
          <p class="ss-track-order-alert-desc" data-alert-desc>This order was cancelled.</p>
        </div>
      </div>

      <!-- Quick Info Meta Grid -->
      <div class="ss-track-meta-grid">
        <div class="ss-track-meta-item">
          <span class="ss-track-meta-label">Order Number</span>
          <strong class="ss-track-meta-val" data-meta-order-id>#SS-9821</strong>
        </div>
        <div class="ss-track-meta-item">
          <span class="ss-track-meta-label">Payment & Order Status</span>
          <strong class="ss-track-meta-val" data-meta-craft-date>Paid</strong>
        </div>
        <div class="ss-track-meta-item">
          <span class="ss-track-meta-label">Courier Partner</span>
          <strong class="ss-track-meta-val" data-meta-courier>Not Assigned</strong>
        </div>
        <div class="ss-track-meta-item">
          <span class="ss-track-meta-label">AWB Tracking No.</span>
          <strong class="ss-track-meta-val ss-track-meta-val--code" data-meta-awb>Not Generated</strong>
        </div>
      </div>

      <!-- 5-Step Visual Crafting & Shipping Progress Bar -->
      <div class="ss-track-progress-card" data-stepper-card>
        <h3 class="ss-track-progress-heading" data-stepper-heading>✦ Sacred Journey of Your Delicacy ✦</h3>
        <div class="ss-track-stepper" data-track-stepper>
          
          <!-- Step 1 -->
          <div class="ss-track-step is-completed" data-step="1">
            <div class="ss-track-step__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </div>
            <div class="ss-track-step__info">
              <strong class="ss-track-step__name">1. Order Placed</strong>
              <span class="ss-track-step__desc">A2 Ghee & Wheat Selected</span>
              <time class="ss-track-step__time" data-step-time-1>Oct 04, 10:15 AM</time>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="ss-track-step is-completed" data-step="2">
            <div class="ss-track-step__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
              </svg>
            </div>
            <div class="ss-track-step__info">
              <strong class="ss-track-step__name">2. Wood-Fire Crafted</strong>
              <span class="ss-track-step__desc">Handmade on Shisham Molds</span>
              <time class="ss-track-step__time" data-step-time-2>Oct 04, 02:30 PM</time>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="ss-track-step is-completed" data-step="3">
            <div class="ss-track-step__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <div class="ss-track-step__info">
              <strong class="ss-track-step__name">3. Aroma-Lock Sealed</strong>
              <span class="ss-track-step__desc">Nitrogen Fresh Box Packed</span>
              <time class="ss-track-step__time" data-step-time-3>Oct 04, 06:00 PM</time>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="ss-track-step is-active" data-step="4">
            <div class="ss-track-step__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="ss-track-step__info">
              <strong class="ss-track-step__name">4. In Transit (Air)</strong>
              <span class="ss-track-step__desc">Dispatched from Darbhanga Hub</span>
              <time class="ss-track-step__time" data-step-time-4>Oct 05, 08:30 AM</time>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="ss-track-step is-pending" data-step="5">
            <div class="ss-track-step__icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <div class="ss-track-step__info">
              <strong class="ss-track-step__name">5. Doorstep Delivery</strong>
              <span class="ss-track-step__desc">Auspicious Box Received</span>
              <time class="ss-track-step__time" data-step-time-5>Expected Oct 08</time>
            </div>
          </div>

        </div>
      </div>

      <!-- 2-Column Split: Detailed Activity Timeline + Package Contents & Quality Seal -->
      <div class="ss-track-details-grid">
        
        <!-- Left: Live Activity Log -->
        <div class="ss-track-card ss-track-log-card">
          <div class="ss-track-card-header">
            <h4 class="ss-track-card-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Live Transit Activity Feed</span>
            </h4>
          </div>
          <div class="ss-track-log-list" data-activity-log-list>
            <!-- Items injected by JS -->
          </div>
        </div>

        <!-- Right: Items In This Parcel & Freshness Pledge -->
        <div class="ss-track-side-col">
          <div class="ss-track-card ss-track-items-card">
            <div class="ss-track-card-header">
              <h4 class="ss-track-card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>Items in This Consignment</span>
              </h4>
            </div>
            <div class="ss-track-items-list" data-items-list>
              <!-- Items injected by JS -->
            </div>
          </div>

          <!-- Quality Guarantee Seal -->
          <div class="ss-track-pledge-card">
            <div class="ss-track-pledge-icon">🪔</div>
            <div class="ss-track-pledge-content">
              <strong>100% Rasoi-Fresh Guarantee</strong>
              <p>Every Thekua in this box was wood-fire fried in 100% Pure Desi Ghee within 24 hours of dispatch. Stays crispy and fragrant for 90 days.</p>
            </div>
          </div>
        </div>

      </div>

    </div>

    {%- comment -%} 5. Tracking & Shipping FAQs Accordion (Fully Editable) {%- endcomment -%}
    {%- if section.settings.show_faqs -%}
      <div class="ss-track-faq-card">
        <div class="ss-track-faq-header">
          {%- if section.settings.faq_eyebrow != blank -%}
            <span class="ss-track-faq-eyebrow">{{ section.settings.faq_eyebrow }}</span>
          {%- endif -%}
          <h3 class="ss-track-faq-title">{{ section.settings.faq_heading | default: 'Courier & Dispatch Guidelines' }}</h3>
          {%- if section.settings.faq_subheading != blank -%}
            <p class="ss-track-faq-subheading">{{ section.settings.faq_subheading }}</p>
          {%- endif -%}
        </div>

        <div class="ss-track-faq-list" data-faq-list>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'faq_item' -%}
                <details class="ss-track-faq-item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="ss-track-faq-trigger">
                    <span>{{ block.settings.question }}</span>
                    <svg class="ss-track-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="ss-track-faq-panel">
                    <p>{{ block.settings.answer }}</p>
                  </div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <details class="ss-track-faq-item" open>
              <summary class="ss-track-faq-trigger">
                <span>How long does delivery take across India?</span>
                <svg class="ss-track-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="ss-track-faq-panel">
                <p>We dispatch all fresh batches directly from our traditional rasoi in Darbhanga, Bihar via Express Air Cargo (BlueDart, Delhivery, DTDC). Standard delivery times are <strong>2-3 working days</strong> for Metro cities (Delhi NCR, Patna, Kolkata, Mumbai, Bangalore) and <strong>3-5 working days</strong> for other regional pin codes across India.</p>
              </div>
            </details>

            <details class="ss-track-faq-item">
              <summary class="ss-track-faq-trigger">
                <span>How does Swaad Samvaad ensure the Thekua stays fresh during transit?</span>
                <svg class="ss-track-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="ss-track-faq-panel">
                <p>Our thekua is fried in 100% Pure Desi Ghee (which acts as a natural Vedic preservative). Each batch is cooled to room temperature, packed in food-grade airtight bags with moisture-absorbers, and housed in our signature gold-embossed crush-resistant box. This guarantees 100% crispiness and aroma for up to 90 days.</p>
              </div>
            </details>

            <details class="ss-track-faq-item">
              <summary class="ss-track-faq-trigger">
                <span>Can I update my delivery address or phone number after ordering?</span>
                <svg class="ss-track-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="ss-track-faq-panel">
                <p>Yes, if your order is still in the "Wood-Fire Crafted" or "Packing" stage (typically within 4-6 hours of placing the order), you can message us instantly on WhatsApp (+91 98765 43210) with your Order ID to update the destination address.</p>
              </div>
            </details>

            <details class="ss-track-faq-item">
              <summary class="ss-track-faq-trigger">
                <span>What should I do if my tracking status is not updating?</span>
                <svg class="ss-track-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="ss-track-faq-panel">
                <p>Air courier scans are updated at each transit hub (e.g. Darbhanga Airport -> Patna Hub -> Destination Airport). Occasionally, scans take 6-12 hours to reflect on the online portal while the flight is in transit. If your tracking has not updated for more than 24 hours, our dispatch team will actively escalate it with the courier manager.</p>
              </div>
            </details>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Swaad Track Order",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs & Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show Breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_text",
      "label": "Breadcrumb Home Label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current_text",
      "label": "Breadcrumb Current Label",
      "default": "Track Order"
    },
    {
      "type": "header",
      "content": "Hero Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "✦ SWAAD SAMVAAD DISPATCH & LOGISTICS ✦"
    },
    {
      "type": "text",
      "id": "heading",
