{% comment %}
  Section: SS Authentic Thekua FAQ Section
  Brand: Swaad Samvaad (Authentic Mithila Handcrafted Thekua)
  Features:
  - Accessible, Smooth Accordion with Animated Rotating Plus-Cross Indicator
  - Mithila Heritage Typography & Golden Card Accents
  - Numbered Question Pills
  - Bottom "Still Have Questions? WhatsApp Us" Support Strip
  - 100% Theme Editor Block Customization
{% endcomment %}

{{ 'ss-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign eyebrow = section.settings.eyebrow_text | default: 'GOT QUESTIONS? WE’VE GOT ANSWERS'
  assign heading = section.settings.heading | default: 'Frequently Asked Questions'
  assign subheading = section.settings.subheading | default: 'Everything you need to know about our ingredients, shelf life, and fresh nationwide shipping.'
  assign bg_color = section.settings.bg_color | default: '#FAF6F0'
  assign show_support_card = section.settings.show_support_card
  assign support_title = section.settings.support_title | default: 'Still have questions about your order?'
  assign support_text = section.settings.support_text | default: 'Our Mithila kitchen team is happy to help you directly on WhatsApp.'
  assign whatsapp_number = section.settings.whatsapp_number | default: '919876543210'
  assign whatsapp_btn_text = section.settings.whatsapp_btn_text | default: 'Chat on WhatsApp'
-%}

<div
  id="faq"
  data-section-id="{{ section_id }}"
  class="ss-faq"
  style="
    --ss-faq-pad-top: {{ section.settings.padding_top | default: 80 }}px;
    --ss-faq-pad-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    --ss-faq-bg-color: {{ bg_color }};
  "
>
  <!-- Traditional Mithila Aripan & Sacred Sun Background Watermark Art -->
  <div class="ss-faq__bg-art" aria-hidden="true">
    <!-- Top Right: Aripan Mandala -->
    <div class="ss-faq__art-item ss-faq__art-item--top-right">
      <svg viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="110" cy="110" r="100" stroke="currentColor" stroke-width="1.8" stroke-dasharray="4 4"/>
        <circle cx="110" cy="110" r="84" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="110" cy="110" r="64" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3"/>
        <circle cx="110" cy="110" r="28" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.08"/>
        <!-- Madhubani Sun Rays & Petals -->
        <path d="M110 10 C118 45 125 45 110 75 C95 45 102 45 110 10 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.2"/>
        <path d="M110 210 C118 175 125 175 110 145 C95 175 102 175 110 210 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.2"/>
        <path d="M10 110 C45 118 45 125 75 110 C45 95 45 102 10 110 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.2"/>
        <path d="M210 110 C175 118 175 125 145 110 C175 95 175 102 210 110 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.2"/>
        <path d="M39 39 C65 60 72 52 85 85 C52 72 60 65 39 39 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1"/>
        <path d="M181 39 C155 60 148 52 135 85 C168 72 160 65 181 39 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1"/>
        <path d="M39 181 C65 160 72 168 85 135 C52 148 60 155 39 181 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1"/>
        <path d="M181 181 C155 160 148 168 135 135 C168 148 160 155 181 181 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1"/>
        <circle cx="110" cy="110" r="10" fill="currentColor"/>
      </svg>
    </div>

    <!-- Bottom Left: Traditional Sancha Thekua Carving -->
    <div class="ss-faq__art-item ss-faq__art-item--bottom-left">
      <svg viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="110" cy="110" r="100" stroke="currentColor" stroke-width="1.8" stroke-dasharray="5 4"/>
        <circle cx="110" cy="110" r="82" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="110" cy="110" r="48" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3 3"/>
        <g stroke="currentColor" stroke-width="1.2">
          <line x1="110" y1="12" x2="110" y2="35"/>
          <line x1="110" y1="185" x2="110" y2="208"/>
          <line x1="12" y1="110" x2="35" y2="110"/>
          <line x1="185" y1="110" x2="208" y2="110"/>
          <line x1="41" y1="41" x2="57" y2="57"/>
          <line x1="163" y1="163" x2="179" y2="179"/>
          <line x1="41" y1="179" x2="57" y2="163"/>
          <line x1="163" y1="57" x2="179" y2="41"/>
        </g>
        <path d="M110 58 C128 85 132 85 162 110 C132 135 128 135 110 162 C92 135 88 135 58 110 C88 85 92 85 110 58 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.3"/>
        <circle cx="110" cy="110" r="14" fill="currentColor" fill-opacity="0.2"/>
      </svg>
    </div>
  </div>

  <div class="ss-faq__container">
    <!-- Header -->
    <div class="ss-faq__header">
      {%- if eyebrow != blank -%}
        <div class="ss-faq__eyebrow">
          <svg class="ss-faq__mithila-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
            <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="16" cy="16" r="4" fill="currentColor"/>
            <path d="M16 2V6M16 26V30M2 16H6M26 16H30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M6.1 6.1L8.9 8.9M23.1 23.1L25.9 25.9M6.1 25.9L8.9 23.1M23.1 8.9L25.9 6.1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M16 6C17.5 9 19 12 22 12C19 15 17.5 18 16 22C14.5 18 13 15 10 12C13 12 14.5 9 16 6Z" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          <span>{{ eyebrow }}</span>
          <svg class="ss-faq__mithila-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
            <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="16" cy="16" r="4" fill="currentColor"/>
            <path d="M16 2V6M16 26V30M2 16H6M26 16H30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M6.1 6.1L8.9 8.9M23.1 23.1L25.9 25.9M6.1 25.9L8.9 23.1M23.1 8.9L25.9 6.1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M16 6C17.5 9 19 12 22 12C19 15 17.5 18 16 22C14.5 18 13 15 10 12C13 12 14.5 9 16 6Z" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="ss-faq__heading">
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="ss-faq__subheading">
          {{ subheading }}
        </p>
      {%- endif -%}
    </div>

    <!-- Accordion List -->
    <div class="ss-faq__list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign question = block.settings.question
            assign answer = block.settings.answer
            assign open_by_default = block.settings.open_by_default
          -%}
          {%- if question != blank -%}
            <details
              class="ss-faq__item"
              {% if open_by_default %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="ss-faq__summary">
                <div class="ss-faq__question-wrap">
                  <span class="ss-faq__num">{{ forloop.index }}</span>
                  <span class="ss-faq__question">{{ question }}</span>
                </div>
                <div class="ss-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </div>
              </summary>
              <div class="ss-faq__answer">
                {{ answer }}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default Items -->
        <details class="ss-faq__item" open>
          <summary class="ss-faq__summary">
            <div class="ss-faq__question-wrap">
              <span class="ss-faq__num">1</span>
              <span class="ss-faq__question">What makes Swaad Samvaad Thekua different from factory cookies?</span>
            </div>
            <div class="ss-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </summary>
          <div class="ss-faq__answer">
            <p>We use 100% Pure Desi Ghee, whole wheat atta, organic jaggery (gud) or pure chini, and freshly ground cardamom. Unlike factory biscuits, our recipe has 0% palm oil, zero chemical preservatives, and is individually pressed by hand on traditional wooden sanchas.</p>
          </div>
        </details>

        <details class="ss-faq__item">
          <summary class="ss-faq__summary">
            <div class="ss-faq__question-wrap">
              <span class="ss-faq__num">2</span>
              <span class="ss-faq__question">What is the shelf life and how should I store it?</span>
            </div>
            <div class="ss-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </summary>
          <div class="ss-faq__answer">
            <p>Our thekuas stay fresh and crunchy for 45 to 60 days from the date of dispatch. Simply store them in the airtight container provided at normal room temperature. No refrigeration needed!</p>
          </div>
        </details>

        <details class="ss-faq__item">
          <summary class="ss-faq__summary">
            <div class="ss-faq__question-wrap">
              <span class="ss-faq__num">3</span>
              <span class="ss-faq__question">Do you deliver across all of India and internationally?</span>
            </div>
            <div class="ss-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </summary>
          <div class="ss-faq__answer">
            <p>Yes! We deliver across 19,000+ Indian pin codes via express air shipping (3-5 business days). We also ship internationally to USA, UK, UAE, Canada, and Europe in specialized crush-proof food-grade packaging.</p>
          </div>
        </details>

        <details class="ss-faq__item">
          <summary class="ss-faq__summary">
            <div class="ss-faq__question-wrap">
              <span class="ss-faq__num">4</span>
              <span class="ss-faq__question">Are your thekuas 100% vegetarian & FSSAI certified?</span>
            </div>
            <div class="ss-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </summary>
          <div class="ss-faq__answer">
            <p>Yes, absolutely. Our kitchen operates strictly as a 100% pure vegetarian facility. Every batch is manufactured, tested, and sealed under our official FSSAI License No. 23322003000077.</p>
          </div>
        </details>
      {%- endif -%}
    </div>

    <!-- Bottom Support Strip -->
    {%- if show_support_card -%}
      <div class="ss-faq__support-card">
        <div class="ss-faq__support-info">
          <div class="ss-faq__support-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="ss-faq__support-title">{{ support_title }}</h4>
            <p class="ss-faq__support-text">{{ support_text }}</p>
          </div>
        </div>

        <a
          href="https://wa.me/{{ whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text=Hi%20Swaad%20Samvaad,%20I%20have%20a%20question%20about%20your%20authentic%20thekua!"
          target="_blank"
          rel="noopener noreferrer"
          class="ss-faq__support-btn"
        >
          <!-- Prominent WhatsApp Vector Icon -->
          <svg class="ss-faq__whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.15C10.57 20.15 9.12 19.75 7.85 19L7.55 18.82L4.43 19.64L5.26 16.6L5.06 16.29C4.24 14.98 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.05 20.15ZM16.57 14.39C16.32 14.26 15.11 13.67 14.88 13.58C14.65 13.5 14.49 13.45 14.32 13.7C14.16 13.95 13.69 14.5 13.54 14.67C13.4 14.83 13.25 14.85 13 14.73C12.75 14.6 11.95 14.34 11 13.5C10.26 12.84 9.76 12.03 9.62 11.78C9.47 11.53 9.6 11.4 9.73 11.27C9.84 11.16 9.97 10.99 10.1 10.84C10.22 10.69 10.26 10.58 10.34 10.42C10.42 10.25 10.38 10.11 10.32 9.98C10.26 9.86 9.76 8.64 9.56 8.14C9.36 7.66 9.15 7.72 9 7.71C8.86 7.71 8.7 7.7 8.53 7.7C8.37 7.7 8.1 7.76 7.87 8.01C7.65 8.26 7.02 8.85 7.02 10.05C7.02 11.25 7.89 12.41 8.02 12.58C8.14 12.74 9.74 15.22 12.2 16.28C12.78 16.53 13.24 16.68 13.59 16.79C14.18 16.98 14.72 16.95 15.15 16.89C15.63 16.82 16.62 16.29 16.83 15.71C17.03 15.13 17.03 14.63 16.97 14.53C16.91 14.43 16.82 14.39 16.57 14.26V14.39Z"/>
          </svg>
          <span>{{ whatsapp_btn_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SS Authentic Thekua FAQ",
  "tag": "section",
  "class": "section-ss-faq",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "GOT QUESTIONS? WE’VE GOT ANSWERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our ingredients, shelf life, and fresh nationwide shipping."
    },
    {
      "type": "header",
      "content": "Support Banner"
    },
    {
      "type": "checkbox",
      "id": "show_support_card",
      "label": "Show Bottom WhatsApp Support Card",
      "default": true
    },
    {
      "type": "text",
      "id": "support_title",
      "label": "Support Banner Title",
      "default": "Still have questions about your order?"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support Banner Subtext",
      "default": "Our Mithila kitchen team is happy to help you directly on WhatsApp."
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number (with Country Code)",
      "default": "919876543210"
    },
    {
      "type": "text",
      "id": "whatsapp_btn_text",
      "label": "WhatsApp Button Text",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "header",
      "content": "Styling & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FAF6F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What makes Swaad Samvaad Thekua different from factory cookies?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We use 100% Pure Desi Ghee, whole wheat atta, organic jaggery (gud) or pure chini, and freshly ground cardamom. Unlike factory biscuits, our recipe has 0% palm oil, zero chemical preservatives, and is individually pressed by hand on traditional wooden sanchas.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Expanded by Default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS Authentic Thekua FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What makes Swaad Samvaad Thekua different from factory cookies?",
            "answer": "<p>We use 100% Pure Desi Ghee, whole wheat atta, organic jaggery (gud) or pure chini, and freshly ground cardamom. Unlike factory biscuits, our recipe has 0% palm oil, zero chemical preservatives, and is individually pressed by hand on traditional wooden sanchas.</p>",
            "open_by_default": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the shelf life and how should I store it?",
            "answer": "<p>Our thekuas stay fresh and crunchy for 45 to 60 days from the date of dispatch. Simply store them in the airtight container provided at normal room temperature. No refrigeration needed!</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you deliver across all of India and internationally?",
            "answer": "<p>Yes! We deliver across 19,000+ Indian pin codes via express air shipping (3-5 business days). We also ship internationally to USA, UK, UAE, Canada, and Europe in specialized crush-proof food-grade packaging.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are your thekuas 100% vegetarian & FSSAI certified?",
            "answer": "<p>Yes, absolutely. Our kitchen operates strictly as a 100% pure vegetarian facility. Every batch is manufactured, tested, and sealed under our official FSSAI License No. 23322003000077.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Which variant should I try first?",
            "answer": "<p>If you love traditional festive warmth, our <strong>Pure Atta Gud (Jaggery) Thekua</strong> is the classic favourite. For a lighter, delicate crunch with evening tea, try our <strong>Traditional Atta Chini Thekua</strong>. We also offer a <strong>Festive Mithila Combo Box</strong> to try all flavours!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
