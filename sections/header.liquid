{% comment %}
  SWAAD SAMVAAD - Main Header Section
  Includes Rotating Announcement Slider, Main Navigation, Search Popup Overlay, Scan Order Modal & Premium Mobile Drawer
{% endcomment %}

{{ 'custom-header.css' | asset_url | stylesheet_tag }}

{% assign header_logo = section.settings.logo | default: settings.logo %}
{% assign wa_phone = section.settings.whatsapp_number | default: '919876543210' | remove: ' ' | remove: '+' | remove: '-' %}
{% assign wa_text = section.settings.whatsapp_message | default: 'Hello Swaad Samvaad, I would like to order fresh Thekua!' %}
{% capture wa_link %}https://wa.me/{{ wa_phone }}?text={{ wa_text | url_param_escape }}{% endcapture %}

<header
  id="header-component"
  class="ss-header-section {% if section.settings.enable_sticky %}ss-header-section--sticky{% endif %} {% if section.settings.enable_overlay and template.name == 'index' %}ss-header-section--overlay{% endif %}"
  style="
    --ss-color-brown-dark: {{ section.settings.color_accent | default: '#3D1E0B' }};
    --ss-color-cream-bg: {{ section.settings.color_bg | default: '#F9F8F3' }};
  "
>
  {% comment %} 1. TOP ANNOUNCEMENT BAR (ROTATING ANIMATED SLIDER) {% endcomment %}
  {% if section.settings.show_announcement %}
    <div
      class="ss-announcement-bar"
      style="
        background-color: {{ section.settings.announcement_bg | default: '#3D1E0B' }};
        color: {{ section.settings.announcement_text_color | default: '#F0E6D8' }};
      "
      data-ss-announcement-speed="{{ section.settings.announcement_speed | default: 4 | times: 1000 }}"
    >
      <div class="ss-announcement-slider">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div
              class="ss-announcement-slide {% if forloop.first %}is-active{% endif %}"
              data-ss-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="ss-announcement-link">
              {% endif %}
                <span class="ss-announcement-icon-badge">{{ block.settings.icon | default: '🌿' }}</span>
                <span class="ss-announcement-text">{{ block.settings.text }}</span>
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          {% comment %} Default animated slides if merchant has not added custom blocks yet {% endcomment %}
          <div class="ss-announcement-slide is-active" data-ss-slide-index="0">
            <span class="ss-announcement-icon-badge">🌿</span>
            <span class="ss-announcement-text">{{ section.settings.announcement_text | default: 'FSSAI Certified License No. : 233220030000077' }}</span>
          </div>
          <div class="ss-announcement-slide" data-ss-slide-index="1">
            <span class="ss-announcement-icon-badge">✨</span>
            <span class="ss-announcement-text">Welcome to Swaad Samvaad • Authentic Taste of Mithila & Home</span>
          </div>
          <div class="ss-announcement-slide" data-ss-slide-index="2">
            <span class="ss-announcement-icon-badge">🔥</span>
            <span class="ss-announcement-text">100% Pure Desi Ghee Thekua • Special Combo Offers Live!</span>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% comment %} 2. MAIN HEADER {% endcomment %}
  <div class="ss-main-header">
    <div class="ss-main-header__container">
      {% comment %} Mobile Menu Hamburger Toggle {% endcomment %}
      <button
        type="button"
        class="ss-mobile-toggle-btn"
        data-ss-trigger="mobile-drawer"
        aria-label="Open Navigation Menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>

      {% comment %} Brand Logo / Badge {% endcomment %}
      <div class="ss-branding">
        <a href="{{ routes.root_url }}" class="ss-brand-logo-link" aria-label="Swaad Samvaad Home">
          {% if header_logo != blank %}
            {{ header_logo | image_url: width: 400 | image_tag: class: 'ss-custom-logo-img', alt: shop.name, loading: 'eager' }}
          {% else %}
            <div class="ss-logo-badge">
              {{ section.settings.logo_initials | default: 'SS' }}
            </div>
            <div class="ss-brand-text-group">
              <span class="ss-brand-title">{{ section.settings.brand_title | default: 'SWAAD SAMVAAD' }}</span>
              <span class="ss-brand-tagline">{{ section.settings.brand_tagline | default: 'TASTE OF MITHILA & HOME' }}</span>
            </div>
          {% endif %}
        </a>
      </div>

      {% comment %} Desktop Navigation Menu {% endcomment %}
      <nav class="ss-nav-menu" aria-label="Main Navigation">
        <ul class="ss-nav-list">
          {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
            {% for link in linklists[section.settings.menu].links %}
              <li class="ss-nav-item{% if link.links != blank %} ss-has-dropdown{% endif %}">
                <a href="{{ link.url }}" class="ss-nav-link{% if link.links != blank %} ss-has-dropdown-link{% endif %}">
                  {% if link.title contains 'FSSAI' or link.title contains 'Quality' %}
                    <span class="ss-green-dot" aria-hidden="true"></span>
                  {% endif %}
                  <span>{{ link.title }}</span>
                  {% if link.links != blank %}
                    <svg class="ss-nav-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="1 1 5 5 9 1"></polyline>
                    </svg>
                  {% endif %}
                </a>

                {% if link.links != blank %}
                  <div class="ss-dropdown-menu">
                    <ul class="ss-dropdown-list">
                      {% for child_link in link.links %}
                        <li class="ss-dropdown-item{% if child_link.links != blank %} ss-has-subdropdown{% endif %}">
                          <a href="{{ child_link.url }}" class="ss-dropdown-link">
                            <span>{{ child_link.title }}</span>
                            {% if child_link.links != blank %}
                              <svg class="ss-subdropdown-chevron" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="1 1 5 5 1 9"></polyline>
                              </svg>
                            {% endif %}
                          </a>

                          {% if child_link.links != blank %}
                            <div class="ss-subdropdown-menu">
                              <ul class="ss-subdropdown-list">
                                {% for grandchild_link in child_link.links %}
                                  <li class="ss-subdropdown-item">
                                    <a href="{{ grandchild_link.url }}" class="ss-subdropdown-link">
                                      {{ grandchild_link.title }}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </div>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            {% comment %} Default reference menu items {% endcomment %}
            <li class="ss-nav-item">
              <a href="{{ routes.all_products_collection_url }}" class="ss-nav-link">Shop Thekua</a>
            </li>
            <li class="ss-nav-item">
              <a href="/pages/why-desi-ghee" class="ss-nav-link">Why Desi Ghee?</a>
            </li>
            <li class="ss-nav-item">
              <a href="/pages/our-story" class="ss-nav-link">Our Story</a>
            </li>
            <li class="ss-nav-item">
              <a href="/pages/fssai-quality" class="ss-nav-link">
                <span class="ss-green-dot" aria-hidden="true"></span>
                FSSAI & Quality
              </a>
            </li>
            <li class="ss-nav-item">
              <a href="/pages/refund-policy" class="ss-nav-link">100% Refund</a>
            </li>
            <li class="ss-nav-item">
              <a href="#reviews" class="ss-nav-link">Reviews</a>
            </li>
          {% endif %}
        </ul>
      </nav>

      {% comment %} Header Utilities (Search, WhatsApp QR, Account, Cart) {% endcomment %}
      <div class="ss-header-actions">
        <!-- Search Trigger -->
        <button
          type="button"
          class="ss-icon-btn"
          data-ss-trigger="search"
          aria-label="Search"
          title="Search Products"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="22" y2="22" />
          </svg>
        </button>

        <!-- WhatsApp QR Code Order Trigger Icon -->
        {% if section.settings.show_whatsapp_qr %}
          <button
            type="button"
            class="ss-icon-btn ss-qr-trigger-btn"
            data-ss-trigger="scan"
            aria-label="Order on WhatsApp via QR"
            title="Order on WhatsApp"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M3 9V5a2 2 0 0 1 2-2h4" />
              <path d="M15 3h4a2 2 0 0 1 2 2v4" />
              <path d="M21 15v4a2 2 0 0 1-2 2h-4" />
              <path d="M9 21H5a2 2 0 0 1-2-2v-4" />
              <rect x="7" y="7" width="3" height="3" fill="currentColor" stroke="none" />
              <rect x="14" y="7" width="3" height="3" fill="currentColor" stroke="none" />
              <rect x="7" y="14" width="3" height="3" fill="currentColor" stroke="none" />
              <rect x="14" y="14" width="3" height="3" fill="currentColor" stroke="none" />
            </svg>
          </button>
        {% endif %}

        <!-- Customer Account / Login Component -->
        {% if shop.customer_accounts_enabled or section.settings.show_account %}
          <div class="ss-account-wrapper">
            {% if customer %}
              <a
                href="{{ routes.account_url }}"
                class="ss-icon-btn ss-account-btn is-logged-in"
                aria-label="My Account"
                title="My Account ({{ customer.first_name }})"
              >
                <span class="ss-account-initials">{{ customer.first_name | slice: 0, 1 | upcase }}</span>
              </a>
            {% else %}
              <button
                type="button"
                class="ss-icon-btn ss-account-btn"
                data-ss-trigger="account"
                aria-label="Sign in or Account"
                title="Sign in or create account"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
              </button>
            {% endif %}

            {% if shop.customer_accounts_enabled %}
              <div style="display:none;" aria-hidden="true">
                <shopify-account></shopify-account>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <!-- Cart Trigger -->
        <a href="{{ routes.cart_url }}" class="ss-icon-btn ss-cart-btn" aria-label="Shopping Cart" title="Shopping Cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4H6z" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <path d="M16 10a4 4 0 01-8 0" />
          </svg>
          <span class="ss-cart-count-badge">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% comment %} 3. INTERACTIVE SEARCH POPUP OVERLAY MODAL {% endcomment %}
<div id="SwaadSearchModal" class="ss-search-modal-container" role="dialog" aria-modal="true" aria-label="Search Popup" hidden>
  <div class="ss-search-backdrop" data-ss-close="search"></div>
  <div class="ss-search-card">
    <form action="{{ routes.search_url }}" method="get" role="search" class="ss-search-form">
      <div class="ss-search-input-wrapper">
        <span class="ss-search-input-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="22" y2="22" />
          </svg>
        </span>
        <input
          type="search"
          name="q"
          class="ss-search-field"
          placeholder="{{ section.settings.search_placeholder | default: 'Search Desi Gud Thekua, Sugar Thekua, Ghee snacks...' }}"
          autocomplete="off"
          autocorrect="off"
          capitalize="off"
          spellcheck="false"
        >
        <button type="button" class="ss-search-close-btn" data-ss-close="search">Close</button>
      </div>
    </form>

    <div class="ss-popular-searches-section">
      <div class="ss-popular-label">Popular Searches:</div>
      <div class="ss-popular-pills-list">
        {% assign popular_tags = section.settings.popular_tags | default: 'Desi Gud 500g, Sugar Thekua 1kg, Pure Ghee Mithila Sweets' | split: ',' %}
        {% for tag in popular_tags %}
          {% assign tag_clean = tag | strip %}
          {% if tag_clean != blank %}
            <button type="button" class="ss-popular-pill-tag" data-query="{{ tag_clean }}">
              {{ tag_clean }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Predictive Search Live Container -->
    <div class="ss-predictive-results" hidden></div>
  </div>
</div>

{% comment %} 4. WHATSAPP & SCAN ORDER QR CODE MODAL {% endcomment %}
<div id="SwaadScanModal" class="ss-scan-modal-container" role="dialog" aria-modal="true" aria-label="Order on WhatsApp" hidden>
  <div class="ss-search-backdrop" data-ss-close="scan"></div>
  <div class="ss-scan-card">
    <button type="button" class="ss-scan-close-btn" data-ss-close="scan" aria-label="Close Modal">✕</button>
    
    <div class="ss-scan-header-badge">
      <span class="ss-whatsapp-badge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="#25D366">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
        </svg>
      </span>
      <span>WhatsApp Quick Order</span>
    </div>

    <h3 class="ss-scan-title">{{ section.settings.qr_modal_title | default: 'Order via WhatsApp' }}</h3>
    <p class="ss-scan-subtitle">{{ section.settings.qr_modal_subtitle | default: 'Scan this QR code with your phone camera or WhatsApp to chat with us and order fresh Mithila Thekua directly!' }}</p>
    
    <div class="ss-qr-box">
      {% if section.settings.custom_qr_image != blank %}
        {{ section.settings.custom_qr_image | image_url: width: 320 | image_tag: class: 'ss-qr-img', alt: 'WhatsApp Order QR Code', loading: 'lazy' }}
      {% else %}
        {% capture qr_api_url %}https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=8&data={{ wa_link | url_encode }}{% endcapture %}
        <img
          src="{{ qr_api_url }}"
          alt="WhatsApp Order QR Code"
          class="ss-qr-img"
          width="180"
          height="180"
          loading="lazy"
        >
      {% endif %}
    </div>

    <!-- Direct Clickable WhatsApp Button -->
    <a
      href="{{ wa_link }}"
      target="_blank"
      rel="noopener noreferrer"
      class="ss-whatsapp-chat-btn"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.84-3.05-.2-.31c-.83-1.32-1.27-2.86-1.27-4.46 0-4.47 3.64-8.11 8.11-8.11 2.16 0 4.2.84 5.73 2.37 1.53 1.53 2.37 3.56 2.37 5.73 0 4.48-3.64 8.12-8.13 8.12zm4.44-6.07c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.21-1.43-1.35-1.67-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42l-.47-.01c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.03s.87 2.35.99 2.52c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z"/>
      </svg>
      <span>Chat on WhatsApp</span>
    </a>

    <div class="ss-scan-footer-note">
      <span>{{ section.settings.whatsapp_footer_text | default: 'Quick response • Order dispatch updates • Custom packaging' }}</span>
    </div>
  </div>
</div>

{% comment %} 5. INTERACTIVE ACCOUNT / SIGN-IN POPUP MODAL (DESKTOP POPOVER & MOBILE BOTTOM SHEET) {% endcomment %}
<div id="SwaadAccountModal" class="ss-account-modal-container" role="dialog" aria-modal="true" aria-label="Sign in or create account" hidden>
  <div class="ss-search-backdrop" data-ss-close="account"></div>
  <div class="ss-account-card">
    <div class="ss-account-card-header">
      <h3 class="ss-account-card-title">Sign in or create account</h3>
      <button type="button" class="ss-account-close-btn" data-ss-close="account" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="ss-account-card-body">
      {%- if section.settings.enable_shop_login -%}
        <!-- Sign in with Shop Button (Only visible when enabled by Admin in Header settings) -->
        <a href="/services/login_with_shop/authorize?locale={{ request.locale.iso_code }}" class="ss-shop-login-btn" aria-label="Sign in with Shop">
          <span class="ss-shop-btn-text">Sign in with</span>
          <span class="ss-shop-logo-text">shop</span>
        </a>

        <!-- Divider -->
        <div class="ss-account-divider">
          <span>OR</span>
        </div>
      {%- endif -%}

      <!-- Email Login Form -->
      <form action="{{ routes.account_login_url }}" method="post" class="ss-account-email-form">
        <input type="hidden" name="form_type" value="customer_login" />
        <input type="hidden" name="utf8" value="✓" />
        <input type="hidden" name="return_to" value="{{ routes.account_url }}" />
        <div class="ss-account-input-group">
          <input
            type="email"
            name="customer[email]"
            class="ss-account-email-input"
            placeholder="Email"
            required
            autocomplete="email"
          />
          <button type="submit" class="ss-account-submit-arrow" aria-label="Submit Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </button>
        </div>

        <label class="ss-account-checkbox-label">
          <input type="checkbox" name="customer[accepts_marketing]" checked="checked" />
          <span>Email me with news and offers</span>
        </label>
      </form>

      <!-- Bottom Quick Navigation Buttons: Orders & Profile -->
      <div class="ss-account-footer-grid">
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}?return_to={{ routes.account_url | url_encode }}{% endif %}"
          class="ss-account-footer-btn"
          title="{% if customer %}View Orders{% else %}Log in to view orders{% endif %}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <line x1="3" y1="10" x2="21" y2="10" />
            <line x1="10" y1="14" x2="14" y2="14" />
          </svg>
          <span>Orders</span>
        </a>
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}?return_to={{ routes.account_url | url_encode }}{% endif %}"
          class="ss-account-footer-btn"
          title="{% if customer %}View Profile{% else %}Log in to view profile{% endif %}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Profile</span>
        </a>
      </div>

      <!-- Quick Register Link -->
      <div class="ss-account-signup-row">
        <span>Don't have an account?</span>
        <a href="{{ routes.account_register_url }}" class="ss-account-register-link">Create one</a>
      </div>
    </div>
  </div>
</div>

{% comment %} 5. PREMIUM MOBILE NAVIGATION DRAWER {% endcomment %}
<div id="SwaadMobileDrawer" class="ss-mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation" hidden>
  <div class="ss-drawer-backdrop" data-ss-close="mobile-drawer"></div>
  <div class="ss-drawer-content">
    {% comment %} Drawer Header {% endcomment %}
    <div class="ss-drawer-header">
      <a href="{{ routes.root_url }}" class="ss-drawer-brand">
        {% if header_logo != blank %}
          {{ header_logo | image_url: width: 220 | image_tag: class: 'ss-custom-logo-img', alt: shop.name, loading: 'lazy' }}
        {% else %}
          <div class="ss-logo-badge" style="width:36px; height:36px; font-size:15px;">
            {{ section.settings.logo_initials | default: 'SS' }}
          </div>
          <span class="ss-brand-title" style="font-size:17px;">{{ section.settings.brand_title | default: 'SWAAD SAMVAAD' }}</span>
        {% endif %}
      </a>
      <button type="button" class="ss-drawer-close-btn" data-ss-close="mobile-drawer" aria-label="Close Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    {% comment %} Drawer Body {% endcomment %}
    <div class="ss-drawer-body">
      <!-- Premium Quick Search Box -->
      <button
        type="button"
        class="ss-drawer-search-box"
        data-ss-trigger="search"
      >
        <svg class="ss-drawer-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="22" y2="22" />
        </svg>
        <span class="ss-drawer-search-placeholder">Search Desi Gud, Thekua, Sweets...</span>
      </button>

      <!-- Clean Navigation List with Chevrons & Expandable Submenus -->
      <ul class="ss-drawer-nav-list">
        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          {% for link in linklists[section.settings.menu].links %}
            <li class="ss-drawer-nav-item{% if link.links != blank %} ss-drawer-has-dropdown{% endif %}">
              {% if link.links != blank %}
                <div class="ss-drawer-nav-row">
                  <a href="{{ link.url }}" class="ss-drawer-nav-link ss-drawer-parent-link">
                    <span class="ss-drawer-nav-label-wrap">
                      {% if link.title contains 'FSSAI' or link.title contains 'Quality' %}
                        <span class="ss-green-dot" aria-hidden="true"></span>
                      {% endif %}
                      {{ link.title }}
                    </span>
                  </a>
                  <button type="button" class="ss-drawer-toggle-btn" aria-expanded="false" aria-label="Toggle {{ link.title }} submenu">
                    <svg class="ss-drawer-toggle-icon" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="1 1 5 5 9 1"></polyline>
                    </svg>
                  </button>
                </div>
                <div class="ss-drawer-submenu" hidden>
                  <ul class="ss-drawer-subnav-list">
                    {% for child_link in link.links %}
                      <li class="ss-drawer-subnav-item{% if child_link.links != blank %} ss-drawer-has-grandchild{% endif %}">
                        {% if child_link.links != blank %}
                          <div class="ss-drawer-subnav-row">
                            <a href="{{ child_link.url }}" class="ss-drawer-subnav-link ss-drawer-subparent-link">
                              {{ child_link.title }}
                            </a>
                            <button type="button" class="ss-drawer-grandchild-toggle-btn" aria-expanded="false" aria-label="Toggle {{ child_link.title }} submenu">
                              <svg class="ss-drawer-toggle-icon" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="1 1 5 5 9 1"></polyline>
                              </svg>
                            </button>
                          </div>
                          <div class="ss-drawer-grandchild-menu" hidden>
                            <ul class="ss-drawer-grandchild-list">
                              {% for grandchild_link in child_link.links %}
                                <li class="ss-drawer-grandchild-item">
                                  <a href="{{ grandchild_link.url }}" class="ss-drawer-grandchild-link">
                                    {{ grandchild_link.title }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          </div>
                        {% else %}
                          <a href="{{ child_link.url }}" class="ss-drawer-subnav-link">
                            <span>{{ child_link.title }}</span>
                            <span class="ss-drawer-subnav-arrow" aria-hidden="true">›</span>
                          </a>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <a href="{{ link.url }}" class="ss-drawer-nav-link">
                  <span class="ss-drawer-nav-label-wrap">
                    {% if link.title contains 'FSSAI' or link.title contains 'Quality' %}
                      <span class="ss-green-dot" aria-hidden="true"></span>
                    {% endif %}
                    {{ link.title }}
                  </span>
                  <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
                </a>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          <li class="ss-drawer-nav-item">
            <a href="{{ routes.all_products_collection_url }}" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">Shop Thekua</span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li class="ss-drawer-nav-item">
            <a href="/pages/why-desi-ghee" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">Why Desi Ghee?</span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li class="ss-drawer-nav-item">
            <a href="/pages/our-story" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">Our Story</span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li class="ss-drawer-nav-item">
            <a href="/pages/fssai-quality" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">
                <span class="ss-green-dot" aria-hidden="true"></span>
                FSSAI & Quality
              </span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li class="ss-drawer-nav-item">
            <a href="/pages/refund-policy" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">100% Refund</span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li class="ss-drawer-nav-item">
            <a href="#reviews" class="ss-drawer-nav-link">
              <span class="ss-drawer-nav-label-wrap">Reviews</span>
              <span class="ss-drawer-nav-arrow" aria-hidden="true">›</span>
            </a>
          </li>
        {% endif %}
      </ul>

      <!-- Mobile Drawer Customer Account Link -->
      {% if shop.customer_accounts_enabled or section.settings.show_account %}
        {% if customer %}
          <a
            href="{{ routes.account_url }}"
            class="ss-drawer-account-link"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>My Account ({{ customer.first_name | default: 'Profile' }})</span>
          </a>
        {% else %}
          <button
            type="button"
            class="ss-drawer-account-link"
            data-ss-trigger="account"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Log in / Sign up</span>
          </button>
        {% endif %}
      {% endif %}

      <!-- Premium WhatsApp Order CTA Card -->
      {% if section.settings.show_whatsapp_qr %}
        <button type="button" class="ss-drawer-scan-card" data-ss-trigger="scan">
          <div class="ss-drawer-scan-icon-wrap">
            <svg viewBox="0 0 24 24" fill="#25D366">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
            </svg>
          </div>
          <div class="ss-drawer-scan-text-wrap">
            <span class="ss-drawer-scan-title">Order via WhatsApp</span>
            <span class="ss-drawer-scan-subtitle">Quick QR / WhatsApp Chat</span>
          </div>
          <span class="ss-drawer-scan-arrow">›</span>
        </button>
      {% endif %}

      <!-- Trust Footer in Drawer -->
      <div class="ss-drawer-footer">
        <span class="ss-drawer-trust-text">🌿 100% Traditional Mithila Taste • Pure Desi Ghee</span>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'custom-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "range",
      "id": "announcement_speed",
      "label": "Slide Change Speed (Seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Fallback Announcement Text",
      "default": "FSSAI Certified License No. : 233220030000077"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#3D1E0B"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Announcement Text Color",
      "default": "#F0E6D8"
    },
    {
      "type": "header",
      "content": "Branding & Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Header Logo (Overrides Theme Setting Logo)"
    },
    {
      "type": "text",
      "id": "logo_initials",
      "label": "Fallback Badge Initials",
      "default": "SS"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "SWAAD SAMVAAD"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "TASTE OF MITHILA & HOME"
    },
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "User Account"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account / Login Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_shop_login",
      "label": "Show 'Sign in with Shop' Button",
      "info": "Toggle the purple 'Sign in with Shop' button. When disabled, only the clean email sign-in form is shown.",
      "default": false
    },
    {
      "type": "header",
      "content": "WhatsApp & QR Code Order"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp_qr",
      "label": "Show WhatsApp QR Icon",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number (with Country Code)",
      "default": "919876543210",
      "info": "Example: 919876543210 (without + sign)"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Pre-filled WhatsApp Message",
      "default": "Hello Swaad Samvaad, I would like to order fresh Mithila Thekua!"
    },
    {
      "type": "image_picker",
      "id": "custom_qr_image",
      "label": "Custom QR Code Image (Optional)",
      "info": "Upload custom QR image if you already have one. If left empty, QR code is automatically generated from your WhatsApp link."
    },
    {
      "type": "text",
      "id": "qr_modal_title",
      "label": "QR Modal Title",
      "default": "Order via WhatsApp"
    },
    {
      "type": "textarea",
      "id": "qr_modal_subtitle",
      "label": "QR Modal Subtitle / Instructions",
      "default": "Scan this QR code with your phone camera or WhatsApp to chat with us and order fresh Mithila Thekua directly!"
    },
    {
      "type": "text",
      "id": "whatsapp_footer_text",
      "label": "WhatsApp Modal Footer Note",
      "default": "Quick response • Order dispatch updates • Custom packaging"
    },
    {
      "type": "header",
      "content": "Search Overlay Settings"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Input Placeholder",
      "default": "Search Desi Gud Thekua, Sugar Thekua, Ghee snacks..."
    },
    {
      "type": "textarea",
      "id": "popular_tags",
      "label": "Popular Search Tags (Comma Separated)",
      "default": "Desi Gud 500g, Sugar Thekua 1kg, Pure Ghee Mithila Sweets"
    },
    {
      "type": "header",
      "content": "Header Styling & Behaviors"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Overlay Homepage Hero",
      "default": false
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Header Background Color",
      "default": "#F9F8F3"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Dark Accent Color",
      "default": "#3D1E0B"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Slide",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "FSSAI Certified License No. : 233220030000077"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji or text)",
          "default": "🌿"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FSSAI Certified License No. : 233220030000077",
            "icon": "🌿"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Welcome to Swaad Samvaad • Authentic Taste of Mithila & Home",
            "icon": "✨"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "100% Pure Desi Ghee Thekua • Special Combo Offers Live!",
            "icon": "🔥"
          }
        }
      ]
    }
  ]
}
{% endschema %}
