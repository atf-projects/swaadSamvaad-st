{% comment %}
  Section contract.
  Swaad Samvaad - Full-Width Luxury Hero Banner Slider.
  Features:
  - Full-width background slider supporting images and videos.
  - Left-aligned dark vignette/gradient shadow overlay for crystal-clear text readability.
  - Rich Mithila traditional branding, Hindi subheadings, dual CTAs, and trust badges.
  - Interactive auto-slide, touch swipe, prev/next arrows, and dot indicators.
  - 100% responsive across mobile, tablet, and desktop.
{% endcomment %}

{{ 'ss-hero-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ss-hero-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign sid = section.id

  if section.index == 1
    assign img_loading = 'eager'
    assign img_priority = 'high'
  else
    assign img_loading = 'lazy'
    assign img_priority = 'auto'
  endif
-%}

<section
  id="hero"
  data-section-id="{{ sid }}"
  class="ss-hero ss-hero--full-slider"
  style="
    --ss-hero-min-height: {{ s.min_height | default: 640 }}px;
    --ss-hero-min-height-mobile: {{ s.min_height_mobile | default: 580 }}px;
    --ss-hero-overlay-color: {{ s.overlay_color | default: '#1B0E07' }};
    --ss-hero-overlay-opacity: {{ s.overlay_opacity | default: 88 }}%;
    --ss-hero-pad-top: {{ s.padding_top | default: 0 }}px;
    --ss-hero-pad-bottom: {{ s.padding_bottom | default: 0 }}px;
  "
  aria-label="{{ s.heading | default: shop.name | escape }}"
  data-ss-hero-section
>
  <div class="ss-hero__slider-wrapper" data-ss-hero-slider-wrap>
    
    {%- comment -%} Full-Width Background Media Slider {%- endcomment -%}
    <div class="ss-hero__bg-slider" data-ss-hero-slider>
      {%- assign media_slide_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- assign media_slide_count = media_slide_count | plus: 1 -%}
          <div class="ss-hero__bg-slide {% if media_slide_count == 1 %}ss-hero__bg-slide--active{% endif %}" data-slide-item {{ block.shopify_attributes }}>
            {%- if block.settings.slide_media_type == 'video' and block.settings.slide_video != blank -%}
              {{
                block.settings.slide_video
                | video_tag:
                  image_size: '1920x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  class: 'ss-hero__bg-media'
              }}
            {%- elsif block.settings.slide_image != blank -%}
              {{
                block.settings.slide_image
                | image_url: width: 2560
                | image_tag:
                  widths: '750, 1100, 1600, 2000, 2560',
                  sizes: '100vw',
                  class: 'ss-hero__bg-media',
                  loading: img_loading,
                  fetchpriority: img_priority,
                  alt: block.settings.slide_image.alt | default: 'Handcrafted Mithila Thekua'
              }}
            {%- else -%}
              {%- assign default_img_index = media_slide_count | minus: 1 | modulo: 3 | plus: 1 -%}
              {%- assign default_slide_asset = 'ss-hero-slide-' | append: default_img_index | append: '.jpg' -%}
              <img
                src="{{ default_slide_asset | asset_url }}"
                alt="Authentic Mithila Handcrafted Thekua"
                class="ss-hero__bg-media"
                loading="{{ img_loading }}"
                width="2000"
                height="1200"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if media_slide_count == 0 -%}
        {%- comment -%} Fallback 3 Slides with Attached Authentic Imagery {%- endcomment -%}
        {%- assign media_slide_count = 3 -%}
        <div class="ss-hero__bg-slide ss-hero__bg-slide--active" data-slide-item>
          <img
            src="{{ 'ss-hero-slide-1.jpg' | asset_url }}"
            alt="Authentic Mithila Desi Ghee Thekua"
            class="ss-hero__bg-media"
            loading="eager"
            width="2000"
            height="1200"
          >
        </div>
        <div class="ss-hero__bg-slide" data-slide-item>
          <img
            src="{{ 'ss-hero-slide-2.jpg' | asset_url }}"
            alt="Festive Carved Peacock & Leaf Thekua Sancha"
            class="ss-hero__bg-media"
            loading="lazy"
            width="2000"
            height="1200"
          >
        </div>
        <div class="ss-hero__bg-slide" data-slide-item>
          <img
            src="{{ 'ss-hero-slide-3.jpg' | asset_url }}"
            alt="Chhath Ghat Sunrise Thekua Prasad"
            class="ss-hero__bg-media"
            loading="lazy"
            width="2000"
            height="1200"
          >
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Gradient Shadow Overlay (Deep Roast Left -> Transparent Right) {%- endcomment -%}
    <div class="ss-hero__gradient-overlay" aria-hidden="true"></div>

    {%- comment -%} Foreground Left-Aligned Content Box {%- endcomment -%}
    <div class="ss-hero__content-container">
      <div class="ss-hero__content-box">
        {%- if s.eyebrow != blank -%}
          <div class="ss-hero__eyebrow" style="color: {{ s.eyebrow_color | default: '#F5C58A' }};">
            <svg class="ss-hero__mithila-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke-dasharray="2 2"/>
              <circle cx="12" cy="12" r="5" fill="currentColor" fill-opacity="0.2"/>
              <path d="M12 2V6M12 18V22M2 12H6M18 12H22" stroke-linecap="round"/>
            </svg>
            <span>{{ s.eyebrow | escape }}</span>
          </div>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <div class="ss-hero__subheading" style="color: {{ s.subheading_color | default: '#F2D7B6' }};">
            {{ s.subheading | escape }}
          </div>
        {%- endif -%}

        {%- if s.heading != blank or s.heading_accent != blank or s.heading_end != blank -%}
          <h1 class="ss-hero__heading" style="color: {{ s.heading_color | default: '#FFFFFF' }};">
            {%- if s.heading != blank -%}{{ s.heading | escape }} {% endif -%}
            {%- if s.heading_accent != blank -%}<em class="ss-hero__heading-accent" style="color: {{ s.heading_accent_color | default: '#F5C58A' }};">{{ s.heading_accent | escape }}</em> {% endif -%}
            {%- if s.heading_end != blank -%}{{ s.heading_end | escape }}{%- endif -%}
          </h1>
        {%- endif -%}

        {%- if s.description != blank -%}
          <div class="ss-hero__desc" style="color: {{ s.desc_color | default: '#EDE0D4' }};">
            {{ s.description }}
          </div>
        {%- endif -%}

        {%- if s.button_1_label != blank or s.button_2_label != blank -%}
          <div class="ss-hero__actions">
            {%- if s.button_1_label != blank -%}
              <a href="{{ s.button_1_link | default: routes.all_products_collection_url }}" class="ss-hero__btn ss-hero__btn--primary" style="background: {{ s.btn1_bg | default: '#B4552B' }}; color: {{ s.btn1_text | default: '#FFFFFF' }};">
                <span>{{ s.button_1_label | escape }}</span>
                <svg class="ss-hero__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a href="{{ s.button_2_link | default: routes.all_products_collection_url }}" class="ss-hero__btn ss-hero__btn--secondary" style="border-color: {{ s.btn2_border | default: 'rgba(245, 197, 138, 0.8)' }}; color: {{ s.btn2_text | default: '#F5C58A' }}; background: {{ s.btn2_bg | default: 'rgba(27, 14, 7, 0.35)' }};">
                <span>{{ s.button_2_label | escape }}</span>
                <svg class="ss-hero__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Trust Badges Pill List {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ss-hero__pill-badges">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' and block.settings.text != blank -%}
                <div class="ss-hero__pill" {{ block.shopify_attributes }}>
                  {%- case block.settings.icon -%}
                    {%- when 'fssai' -%}
                      <img src="{{ 'fssai-logo.png' | asset_url }}" alt="" class="ss-hero__pill-fssai" width="36" height="16" loading="lazy">
                    {%- when 'leaf' -%}
                      <svg class="ss-hero__pill-icon ss-hero__pill-icon--green" viewBox="0 0 24 24"><path fill="currentColor" d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
                    {%- when 'shield' -%}
                      <svg class="ss-hero__pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    {%- when 'no' -%}
                      <svg class="ss-hero__pill-icon ss-hero__pill-icon--red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                  {%- endcase -%}
                  <span>{{ block.settings.text | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Floating Rating Capsule {%- endcomment -%}
        {%- if s.show_rating_card -%}
          <div class="ss-hero__rating-badge">
            <div class="ss-hero__rating-row">
              <div class="ss-hero__stars">★</div>
              <div class="ss-hero__rating-num">{{ s.rating_value | default: '4.9 / 5' }}</div>
            </div>
            <div class="ss-hero__rating-label">{{ s.rating_text | default: '2,300+ families across 14 countries' }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Slider Prev / Next Controls {%- endcomment -%}
    {%- if media_slide_count > 1 -%}
      <button type="button" class="ss-hero__nav-btn ss-hero__nav-btn--prev" data-slide-nav="prev" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="ss-hero__nav-btn ss-hero__nav-btn--next" data-slide-nav="next" aria-label="Next slide">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      {%- comment -%} Slider Navigation Dots {%- endcomment -%}
      <div class="ss-hero__slider-dots">
        {%- for i in (1..media_slide_count) -%}
          <button type="button" class="ss-hero__dot {% if forloop.first %}ss-hero__dot--active{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Swaad Hero Banner",
  "tag": "div",
  "class": "ss-hero-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Banner Dimensions & Overlay"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop Banner Min Height",
      "min": 450,
      "max": 850,
      "step": 10,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Mobile Banner Min Height",
      "min": 420,
      "max": 750,
      "step": 10,
      "unit": "px",
      "default": 560
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Left Shadow / Vignette Color",
      "default": "#1B0E07"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Left Shadow Intensity (%)",
      "min": 50,
      "max": 98,
      "step": 2,
      "unit": "%",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Tagline",
      "default": "HANDCRAFTED · SMALL BATCH · SINCE GRANDMA'S RECIPE"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#F5C58A"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Hindi Text)",
      "default": "स्वाद संवाद — मिथिला की मिठास, अब आपके घर"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#F2D7B6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Start",
      "default": "Authentic Taste of"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent (Italic Serif)",
      "default": "Mithila & Bihar"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading End",
      "default": "— Handcrafted Desi Cookies"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_accent_color",
      "label": "Heading Accent Color",
      "default": "#F5C58A"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Text",
      "default": "<p>Slow-made thekua with pure desi ghee, organic jaggery & whole wheat — the same recipe our grandmothers hand-molded for Chhath, festivals, and homecomings. Two recipes. Zero shortcuts.</p>"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#EDE0D4"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 Label",
      "default": "Shop Gud Thekua"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "color",
      "id": "btn1_bg",
      "label": "Button 1 Background",
      "default": "#B4552B"
    },
    {
      "type": "color",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 Label",
      "default": "Shop Sugar Thekua"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "color",
      "id": "btn2_border",
      "label": "Button 2 Border",
      "default": "rgba(245, 197, 138, 0.8)"
    },
    {
      "type": "color",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "#F5C58A"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Button 2 Background",
      "default": "rgba(27, 14, 7, 0.35)"
    },
    {
      "type": "header",
      "content": "Floating Trust Badge (Rating)"
    },
    {
      "type": "checkbox",
      "id": "show_rating_card",
      "label": "Show Rating Card",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating Score",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Note",
      "default": "2,300+ families across 14 countries"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Media Slide",
      "settings": [
        {
          "type": "select",
          "id": "slide_media_type",
          "label": "Slide Media Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Slide Image"
        },
        {
          "type": "video",
          "id": "slide_video",
          "label": "Slide Video"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Pill Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "fssai", "label": "FSSAI Logo" },
            { "value": "leaf", "label": "Green Leaf (Veg)" },
            { "value": "shield", "label": "Shield Check" },
            { "value": "no", "label": "No Preservatives" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% Vegetarian"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swaad Hero Banner",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "badge", "settings": { "icon": "fssai", "text": "FSSAI Lic. 23322003000077" } },
        { "type": "badge", "settings": { "icon": "leaf", "text": "100% Vegetarian" } },
        { "type": "badge", "settings": { "icon": "no", "text": "No Preservatives" } }
      ]
    }
  ]
}
{% endschema %}
