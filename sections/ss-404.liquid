{% comment %}
  Section: Swaad Samvaad - Luxury Minimalist 404 Error Page (sections/ss-404.liquid)
  Features:
  - Heritage Breadcrumbs.
  - Clean, centered ultra-luxury card with warm Mithila aesthetics.
  - Metallic gold-foil 404 serif numeral typography.
  - Refined search bar.
  - Two primary/secondary CTA buttons: "Explore Our Thekuas" & "Return to Home".
  - 100% Custom Scoped CSS & Fully Responsive.
{% endcomment %}

{{ 'ss-404.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: 'Page Not Found'
  assign subheading = section.settings.subheading | default: 'The page you are looking for might have been moved, renamed, or is temporarily unavailable. Let us guide you back to our authentic handcrafted delicacies.'
  assign show_search = section.settings.show_search
-%}

<section
  id="ss-404-{{ section.id }}"
  class="ss-404-section"
  data-ss-404-page
  style="
    --ss-404-pad-top: {{ section.settings.padding_top | default: 48 }}px;
    --ss-404-pad-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
  "
>
  <div class="ss-404-container">

    <!-- 1. Breadcrumbs -->
    <nav class="ss-404-breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="ss-404-breadcrumbs__sep">❖</span>
      <span class="ss-404-breadcrumbs__current">404 Page Not Found</span>
    </nav>

    <!-- 2. Main Luxury 404 Card -->
    <div class="ss-404-card">
      
      <!-- 404 Gold-Foil Typography -->
      <div class="ss-404-glamour-badge">
        <span class="ss-404-number">404</span>
      </div>

      <h1 class="ss-404-title">{{ heading }}</h1>
      <p class="ss-404-desc">{{ subheading }}</p>

      <!-- Refined Search Form -->
      {%- if show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="ss-404-search-form">
          <div class="ss-404-search-wrap">
            <svg class="ss-404-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              placeholder="Search for Gud Thekua, Sugar Thekua, Mithila recipes..."
              class="ss-404-search-input"
              aria-label="Search delicacies"
              required
            >
            <button type="submit" class="ss-404-search-btn">
              <span>Search</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </form>
      {%- endif -%}

      <!-- Action Buttons -->
      <div class="ss-404-actions">
        <a href="{{ routes.all_products_collection_url }}" class="ss-404-btn ss-404-btn--primary">
          <span>Explore Our Thekuas</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a href="{{ routes.root_url }}" class="ss-404-btn ss-404-btn--secondary">
          <span>Return to Home</span>
          <span class="ss-404-btn-sep">❖</span>
        </a>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "SS Luxury 404 Page",
  "tag": "section",
  "class": "ss-404-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page Not Found"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "The page you are looking for might have been moved, renamed, or is temporarily unavailable. Let us guide you back to our authentic handcrafted delicacies."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "SS Luxury 404 Page"
    }
  ]
}
{% endschema %}
