{% comment %}
  Section: SS Wall of Love & Infinite Vertical Marquee Reviews
  Brand: Swaad Samvaad (Authentic Mithila Handcrafted Thekua)
  Features:
  - Header: Eyebrow + Serif Heading "Loved Across India & Abroad" + Gold Star Rating Badge
  - 3-Column Infinite Vertical Marquee:
      * Left Column: Scrolls UP
      * Middle Column: Scrolls DOWN
      * Right Column: Scrolls UP
  - Top & Bottom Soft Fade Masks (Transparent to Solid)
  - Hover Pause Effect (Smooth stop on hover)
  - Heritage Mithila Tradition Background Accents (Low Opacity)
  - 100% Shopify Theme Editor Editable Blocks & Controls
{% endcomment %}

{{ 'ss-reviews-wall.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign eyebrow = section.settings.eyebrow_text | default: 'REAL CUSTOMER EXPERIENCE'
  assign heading = section.settings.heading | default: 'Loved Across India & Abroad'
  assign rating_text = section.settings.rating_badge_text | default: '4.9 out of 5 based on 1,420+ verified reviews'
  assign bg_color = section.settings.bg_color | default: '#F5ECE1'
  assign bg_image = section.settings.bg_image
  assign bg_image_opacity = section.settings.bg_image_opacity | default: 28
  assign bg_image_blur = section.settings.bg_image_blur | default: 0
  assign wall_height = section.settings.wall_height | default: 580
  assign scroll_speed = section.settings.scroll_speed | default: 34
  assign show_bg_motifs = section.settings.show_bg_motifs
  assign bg_motifs_opacity = section.settings.bg_motifs_opacity | default: 6
-%}

<div
  id="reviews"
  data-section-id="{{ section_id }}"
  class="ss-rwall"
  style="
    --ss-rwall-pad-top: {{ section.settings.padding_top | default: 80 }}px;
    --ss-rwall-pad-bottom: {{ section.settings.padding_bottom | default: 90 }}px;
    --ss-rwall-bg-color: {{ bg_color }};
    --ss-rwall-height: {{ wall_height }}px;
    --ss-rwall-speed: {{ scroll_speed }}s;
    --ss-rwall-speed-alt: {{ scroll_speed | times: 1.15 }}s;
  "
>
  <!-- Bihar & Mithila Traditional Village Landscape Background with Controlled Opacity -->
  <div
    class="ss-rwall__bg-layer"
    style="
      opacity: {{ bg_image_opacity | divided_by: 100.0 }};
      {%- if bg_image_blur > 0 -%}
        filter: blur({{ bg_image_blur }}px);
      {%- endif -%}
    "
    aria-hidden="true"
  >
    {%- if bg_image != blank -%}
      {{ bg_image | image_url: width: 2400 | image_tag: class: 'ss-rwall__bg-img', loading: 'lazy', alt: 'Mithila Village Landscape' }}
    {%- else -%}
      <img
        src="{{ 'ss-village-landscape.png' | asset_url }}"
        alt="Mithila Village Landscape"
        class="ss-rwall__bg-img"
        loading="lazy"
        width="2400"
        height="1200"
      >
    {%- endif -%}
  </div>

  <div class="ss-rwall__container">
    <!-- Section Header -->
    <div class="ss-rwall__header">
      {%- if eyebrow != blank -%}
        <div class="ss-rwall__eyebrow">
          <span>{{ eyebrow }}</span>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="ss-rwall__heading">
          {{ heading }}
        </h2>
      {%- endif -%}

      <!-- Golden Rating Badge -->
      {%- if rating_text != blank -%}
        <div class="ss-rwall__rating-badge">
          <div class="ss-rwall__rating-stars" aria-label="5 star rating">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <span class="ss-rwall__rating-text">{{ rating_text }}</span>
          <div class="ss-rwall__rating-underline" aria-hidden="true"></div>
        </div>
      {%- endif -%}
    </div>

    <!-- 3-Column Infinite Vertical Marquee Wall -->
    <div class="ss-rwall__stage">
      <!-- Top and Bottom Smooth Fade Gradient Overlays -->
      <div class="ss-rwall__fade ss-rwall__fade--top" aria-hidden="true"></div>
      <div class="ss-rwall__fade ss-rwall__fade--bottom" aria-hidden="true"></div>

      <div class="ss-rwall__columns-grid">
        <!-- Column 1: Scrolls UP -->
        <div class="ss-rwall__col ss-rwall__col--1" data-scroll-direction="up">
          <div class="ss-rwall__track ss-rwall__track--up">
            {%- capture col1_cards -%}
              {%- for block in section.blocks -%}
                {%- assign mod = forloop.index0 | modulo: 3 -%}
                {%- if mod == 0 -%}
                  {%- render 'ss-rwall-card', block: block -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if col1_cards == blank -%}
              {%- capture col1_cards -%}
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Reminds me exactly of my grandmother’s house in Darbhanga! Perfect crunch and authentic cardamom taste. My kids love eating these healthy cookies instead of store biscuits.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">RP</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Rohan Prakash</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Bengaluru</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“The aroma of pure desi ghee when you tear open the seal is unreal. Authentic Bihari Chhath style taste in every single bite.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">MG</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Manish Gupta</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Pune</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Zero palm oil, zero chemicals. Finally a traditional sweet snack I can give my toddlers without feeling guilty.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">ND</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Neha Dixit</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Hyderabad</span>
                    </div>
                  </div>
                </div>
              {%- endcapture -%}
            {%- endif -%}

            {{ col1_cards }}
            <!-- Duplicate for Seamless Infinite Loop -->
            {{ col1_cards }}
          </div>
        </div>

        <!-- Column 2: Scrolls DOWN -->
        <div class="ss-rwall__col ss-rwall__col--2" data-scroll-direction="down">
          <div class="ss-rwall__track ss-rwall__track--down">
            {%- capture col2_cards -%}
              {%- for block in section.blocks -%}
                {%- assign mod = forloop.index0 | modulo: 3 -%}
                {%- if mod == 1 -%}
                  {%- render 'ss-rwall-card', block: block -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if col2_cards == blank -%}
              {%- capture col2_cards -%}
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Ordered the Gud Thekua to London! Packaging was airtight, zero breakage, and the taste is 100% authentic pure ghee flavor. Will order the 1kg pack next!”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">SJ</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Sunita Jha</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · London, UK</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Even my in-laws from Patna approved! Said it tastes exactly like home-made thekua made on an earthen stove.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">AS</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Aditi Singh</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Mumbai</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Fresh batch delivered in 3 days. Cardamom and saunf balance is on point. Subscribed for monthly box.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">VK</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Vikram Kumar</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Gurugram</span>
                    </div>
                  </div>
                </div>
              {%- endcapture -%}
            {%- endif -%}

            {{ col2_cards }}
            <!-- Duplicate for Seamless Infinite Loop -->
            {{ col2_cards }}
          </div>
        </div>

        <!-- Column 3: Scrolls UP -->
        <div class="ss-rwall__col ss-rwall__col--3" data-scroll-direction="up">
          <div class="ss-rwall__track ss-rwall__track--up ss-rwall__track--alt">
            {%- capture col3_cards -%}
              {%- for block in section.blocks -%}
                {%- assign mod = forloop.index0 | modulo: 3 -%}
                {%- if mod == 2 -%}
                  {%- render 'ss-rwall-card', block: block -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if col3_cards == blank -%}
              {%- capture col3_cards -%}
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“The sugar thekua crunch is incredible! Crisp on the outside, rich inside. Loved that it is FSSAI certified and completely free of chemicals.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">AM</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Ankit Mishra</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · New Delhi</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Shipped all the way to Dubai for Diwali celebrations. Not a single crushed piece. Everyone at the party was asking for the link.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">RT</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Ritu Thakur</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Dubai, UAE</span>
                    </div>
                  </div>
                </div>
                <div class="ss-rwall-card">
                  <div class="ss-rwall-card__stars">★★★★★</div>
                  <p class="ss-rwall-card__quote">“Super authentic sancha impressions on the thekua. Made with pure ghee and genuine love.”</p>
                  <div class="ss-rwall-card__author-wrap">
                    <div class="ss-rwall-card__avatar">SK</div>
                    <div class="ss-rwall-card__author-info">
                      <strong class="ss-rwall-card__name">Shweta Keshri</strong>
                      <span class="ss-rwall-card__loc">Verified Buyer · Noida</span>
                    </div>
                  </div>
                </div>
              {%- endcapture -%}
            {%- endif -%}

            {{ col3_cards }}
            <!-- Duplicate for Seamless Infinite Loop -->
            {{ col3_cards }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SS Reviews Wall (Marquee)",
  "tag": "section",
  "class": "section-ss-reviews-wall",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "REAL CUSTOMER EXPERIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Loved Across India & Abroad"
    },
    {
      "type": "text",
      "id": "rating_badge_text",
      "label": "Rating Badge Text",
      "default": "4.9 out of 5 based on 1,420+ verified reviews"
    },
    {
      "type": "header",
      "content": "Animation & Wall Height"
    },
    {
      "type": "range",
      "id": "wall_height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Wall Container Height",
      "default": 580
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 15,
      "max": 70,
      "step": 1,
      "unit": "s",
      "label": "Scroll Animation Duration (Seconds)",
      "default": 34
    },
    {
      "type": "header",
      "content": "Styling & Village Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F5ECE1"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Upload from Dashboard)",
      "info": "Upload custom village art or background. If empty, default Bihar village art is displayed."
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Background Image Opacity",
      "default": 28
    },
    {
      "type": "range",
      "id": "bg_image_blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Background Image Blur",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "customer_review",
      "name": "Customer Review Card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote Text",
          "default": "Reminds me exactly of my grandmother’s house in Darbhanga! Perfect crunch and authentic cardamom taste. My kids love eating these healthy cookies instead of store biscuits."
        },
        {
          "type": "text",
          "id": "author_initials",
          "label": "Avatar Initials (e.g. RP)",
          "default": "RP"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Full Name",
          "default": "Rohan Prakash"
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Location & Tag",
          "default": "Bengaluru"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Verified Buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
