# ==========================================
# Shopify Theme CLI & Environment Credentials
# ==========================================
# Prevents leaking store domain, theme ID, and CLI authentication tokens
.shopify/
shopify.theme.toml
*.theme.toml
.shopify-build/

# ==========================================
# Theme Archives & Backups (ZIPs)
# ==========================================
# Prevents pushing large theme zips to git
*.zip
*.tar.gz
*.tgz
backup/
backups/

# ==========================================
# Node & Build Tooling
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
assets/node_modules/

# ==========================================
# Developer Tooling & Local IDE Settings
# ==========================================
assets/jsconfig.json
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
assets/*.d.ts

# ==========================================
# OS & System Metadata (Mac / Windows)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.code-review-graph

# ==========================================
# Environment Variables & Secret Keys
# ==========================================
.env
.env.*
*.pem
*.key
*.cert
*.p12
id_rsa*
*.log