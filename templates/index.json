    "ss_brand_story_main": {
      "type": "ss-brand-story",
      "settings": {
        "eyebrow_text": "OUR STORY \u2022 MITHILA HERITAGE",
        "heading_prefix": "From the hearths of",
        "heading_highlight": "Mithila",
        "heading_suffix": "to your home",
        "story_p1": "In every Maithili home, thekua is not a snack \u2014 it is an offering. Molded by hand for Chhath Puja, packed into steel dabbas for traveling sons and daughters, and broken open at midnight with a glass of milk. It carries the taste of belonging.",
        "story_p2": "Swaad Samvaad began with one stubborn belief: that this taste deserves to travel beyond Bihar without losing its soul. No maida. No preservatives. No factory shortcuts. Just atta, desi ghee, jaggery or sugar, and cardamom \u2014 pressed one piece at a time, exactly the way it has been done for generations.",
        "feat_1_title": "Pure Desi Ghee",
        "feat_1_sub": "slow-cooked, small-batch",
        "feat_2_title": "Jaggery & Sugar",
        "feat_2_sub": "no refined sweeteners",
        "feat_3_title": "Hand-Molded",
        "feat_3_sub": "one piece at a time",
        "note_tag": "MITHILA'S LOVE LANGUAGE",
        "note_text": "\u0920\u0947\u0915\u0941\u0906 \u2014 \u092e\u093f\u0925\u093f\u0932\u093e \u0915\u0947 \u092a\u094d\u0930\u0947\u092e \u0915\u0940 \u092d\u093e\u0937\u093e",
        "bg_color": "#422312",
        "show_border_patterns": true,
        "padding_top": 84,
        "padding_bottom": 96
      }
    },
