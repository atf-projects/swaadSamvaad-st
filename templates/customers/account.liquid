{% comment %}
  SWAAD SAMVAAD - Customer Account & Order History Dashboard Template
{% endcomment %}

<div class="ss-account-page-wrapper">
  <div class="ss-account-dashboard-container">
    {% comment %} Header Row {% endcomment %}
    <div class="ss-account-header-row">
      <div>
        <span class="ss-account-kicker">MY ACCOUNT</span>
        <h1 class="ss-account-heading">Welcome, {{ customer.first_name | default: 'Customer' }}!</h1>
        <p class="ss-account-subhead">Manage your Mithila Thekua orders, shipping addresses, and personal profile.</p>
      </div>
      <div class="ss-account-header-actions">
        <a href="{{ routes.account_logout_url }}" class="ss-account-logout-btn">Log Out</a>
      </div>
    </div>

    {% comment %} Dashboard Grid: Orders (Left/Main) & Profile Info (Right) {% endcomment %}
    <div class="ss-account-dashboard-grid">
      {% comment %} 1. ORDERS HISTORY {% endcomment %}
      <div class="ss-account-orders-section">
        <h2 class="ss-section-title">Order History</h2>

        {% paginate customer.orders by 10 %}
          {% if customer.orders.size > 0 %}
            <div class="ss-orders-table-wrapper">
              <table class="ss-orders-table">
                <thead>
                  <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Payment</th>
                    <th>Fulfillment</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {% for order in customer.orders %}
                    <tr>
                      <td data-label="Order">
                        <a href="{{ order.customer_url }}" class="ss-order-number-link">
                          {{ order.name }}
                        </a>
                      </td>
                      <td data-label="Date">{{ order.created_at | date: "%b %d, %Y" }}</td>
                      <td data-label="Payment">
                        <span class="ss-status-badge ss-status--{{ order.financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                      </td>
                      <td data-label="Fulfillment">
                        <span class="ss-status-badge ss-status--{{ order.fulfillment_status }}">
                          {{ order.fulfillment_status_label }}
                        </span>
                      </td>
                      <td data-label="Total" class="ss-order-total">{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

            {% if paginate.pages > 1 %}
              <div class="ss-pagination">
                {{ paginate | default_pagination }}
              </div>
            {% endif %}
          {% else %}
            <div class="ss-orders-empty-state">
              <div class="ss-empty-icon">📦</div>
              <h3 class="ss-empty-title">No orders placed yet</h3>
              <p class="ss-empty-text">You haven't ordered any delicious handcrafted Thekua sweets yet. Taste the tradition of Mithila today!</p>
              <a href="{{ routes.all_products_collection_url }}" class="ss-empty-cta-btn">
                Browse Thekua Collection
              </a>
            </div>
          {% endif %}
        {% endpaginate %}
      </div>

      {% comment %} 2. ACCOUNT DETAILS & PROFILE {% endcomment %}
      <div class="ss-account-profile-section">
        <div class="ss-profile-card">
          <h2 class="ss-section-title">Account Details</h2>

          <div class="ss-profile-info-group">
            <span class="ss-profile-label">Customer Name</span>
            <span class="ss-profile-value">{{ customer.name }}</span>
          </div>

          <div class="ss-profile-info-group">
            <span class="ss-profile-label">Email Address</span>
            <span class="ss-profile-value">{{ customer.email }}</span>
          </div>

          <div class="ss-profile-info-group">
            <span class="ss-profile-label">Primary Address</span>
            {% if customer.default_address %}
              <div class="ss-profile-address">
                {{ customer.default_address | format_address }}
              </div>
            {% else %}
              <span class="ss-profile-value text-muted">No primary address saved yet.</span>
            {% endif %}
          </div>

          <div class="ss-profile-actions">
            <a href="{{ routes.account_addresses_url }}" class="ss-profile-address-btn">
              Manage Addresses ({{ customer.addresses_count }})
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ss-account-page-wrapper {
    background-color: var(--ss-color-cream-bg, #F9F8F3);
    min-height: 80vh;
    padding: 48px 24px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .ss-account-dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ss-account-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 28px;
    border-bottom: 1.5px solid rgba(198, 156, 109, 0.2);
    margin-bottom: 36px;
  }

  .ss-account-kicker {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--ss-color-gold-accent, #C69C6D);
    letter-spacing: 2px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .ss-account-heading {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: var(--ss-color-brown-dark, #3D1E0B);
    margin: 0 0 6px 0;
    letter-spacing: -0.3px;
  }

  .ss-account-subhead {
    font-size: 14.5px;
    color: var(--ss-color-text-muted, #8C6D53);
    margin: 0;
  }

  .ss-account-logout-btn {
    border: 1.5px solid #DED7CF;
    background: #FFFFFF;
    color: var(--ss-color-brown-dark, #3D1E0B);
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ss-account-logout-btn:hover {
    border-color: var(--ss-color-brown-dark, #3D1E0B);
    background-color: var(--ss-color-brown-dark, #3D1E0B);
    color: #FFFFFF;
  }

  .ss-account-dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 36px;
  }

  .ss-section-title {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--ss-color-brown-dark, #3D1E0B);
    margin: 0 0 20px 0;
    letter-spacing: -0.2px;
  }

  /* Table styling */
  .ss-orders-table-wrapper {
    background: #FFFFFF;
    border-radius: 14px;
    border: 1px solid rgba(198, 156, 109, 0.2);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(61, 30, 11, 0.04);
  }

  .ss-orders-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 14px;
  }

  .ss-orders-table th {
    background: #FAF6F0;
    padding: 14px 18px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--ss-color-brown-dark, #3D1E0B);
    border-bottom: 1px solid rgba(198, 156, 109, 0.2);
  }

  .ss-orders-table td {
    padding: 16px 18px;
    border-bottom: 1px solid #F0EAE2;
    color: var(--ss-color-text-dark, #2B2523);
  }

  .ss-orders-table tr:last-child td {
    border-bottom: none;
  }

  .ss-order-number-link {
    color: var(--ss-color-brown-dark, #3D1E0B);
    font-weight: 700;
    text-decoration: underline;
  }

  .ss-status-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: capitalize;
    background: #F4ECE1;
    color: var(--ss-color-brown-dark, #3D1E0B);
  }

  .ss-status--paid, .ss-status--fulfilled {
    background: #E8F8EE;
    color: #128C7E;
  }

  .ss-status--unfulfilled, .ss-status--pending {
    background: #FFF4E5;
    color: #B76E00;
  }

  .ss-order-total {
    font-weight: 700;
    color: var(--ss-color-brown-dark, #3D1E0B);
  }

  /* Empty state */
  .ss-orders-empty-state {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 48px 24px;
    text-align: center;
    border: 1px dashed rgba(198, 156, 109, 0.35);
  }

  .ss-empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
  }

  .ss-empty-title {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--ss-color-brown-dark, #3D1E0B);
    margin: 0 0 8px 0;
  }

  .ss-empty-text {
    font-size: 14px;
    color: var(--ss-color-text-muted, #8C6D53);
    max-width: 400px;
    margin: 0 auto 20px auto;
    line-height: 1.45;
  }

  .ss-empty-cta-btn {
    display: inline-block;
    background: var(--ss-color-brown-dark, #3D1E0B);
    color: #FFFFFF;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .ss-empty-cta-btn:hover {
    background: #5D331A;
  }

  /* Profile Card */
  .ss-profile-card {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid rgba(198, 156, 109, 0.2);
    box-shadow: 0 4px 20px rgba(61, 30, 11, 0.04);
  }

  .ss-profile-info-group {
    margin-bottom: 18px;
  }

  .ss-profile-label {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--ss-color-text-muted, #8C6D53);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: block;
    margin-bottom: 4px;
  }

  .ss-profile-value {
    font-size: 14.5px;
    color: var(--ss-color-text-dark, #2B2523);
    font-weight: 600;
  }

  .ss-profile-address {
    font-size: 13.5px;
    color: var(--ss-color-text-dark, #2B2523);
    line-height: 1.4;
  }

  .ss-profile-address p {
    margin: 2px 0;
  }

  .ss-profile-actions {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid #F0EAE2;
  }

  .ss-profile-address-btn {
    display: block;
    text-align: center;
    background: #FAF6F0;
    border: 1px solid #E5DCD3;
    color: var(--ss-color-brown-dark, #3D1E0B);
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ss-profile-address-btn:hover {
    background: #EFE6DC;
    border-color: var(--ss-color-brown-dark, #3D1E0B);
  }

  @media (max-width: 860px) {
    .ss-account-dashboard-grid {
      grid-template-columns: 1fr;
    }

    .ss-account-heading {
      font-size: 26px;
    }
  }
</style>
