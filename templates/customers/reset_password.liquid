{% comment %}
  SWAAD SAMVAAD - Reset Password Template
{% endcomment %}

<div class="ss-auth-page-wrapper">
  <div class="ss-auth-container">
    <div class="ss-auth-card">
      <div class="ss-auth-header">
        <span class="ss-auth-badge">SECURITY</span>
        <h1 class="ss-auth-title">Reset Password</h1>
        <p class="ss-auth-subtitle">Enter a new password for your account</p>
      </div>

      {% form 'reset_customer_password', class: 'ss-auth-form' %}
        {% if form.errors %}
          <div class="ss-auth-error-box" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="ss-auth-field-group">
          <label for="ResetPassword" class="ss-auth-label">New Password</label>
          <input
            type="password"
            name="customer[password]"
            id="ResetPassword"
            class="ss-auth-input"
            autocomplete="new-password"
            placeholder="New password"
            required
          >
        </div>

        <div class="ss-auth-field-group">
          <label for="PasswordConfirmation" class="ss-auth-label">Confirm Password</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="PasswordConfirmation"
            class="ss-auth-input"
            autocomplete="new-password"
            placeholder="Confirm password"
            required
          >
        </div>

        <button type="submit" class="ss-auth-submit-btn">
          Reset Password
        </button>
      {% endform %}
    </div>
  </div>
</div>

<style>
  .ss-auth-page-wrapper {
    min-height: calc(100vh - 200px);
    background-color: var(--ss-color-cream-bg, #F9F8F3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    font-family: var(--ss-font-sans, system-ui, -apple-system, sans-serif);
  }
  .ss-auth-container { width: 100%; max-width: 440px; }
  .ss-auth-card {
    background: #FFFFFF;
    border: 1px solid rgba(198, 156, 109, 0.25);
    border-radius: 16px;
    padding: 40px 32px;
    box-shadow: 0 10px 35px rgba(61, 30, 11, 0.06);
  }
  .ss-auth-header { text-align: center; margin-bottom: 24px; }
  .ss-auth-badge {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--ss-color-brown-dark, #3D1E0B); background: #F4ECE1; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px;
  }
  .ss-auth-title {
    font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    font-size: 26px; font-weight: 700; color: var(--ss-color-brown-dark, #3D1E0B); margin: 0 0 8px 0;
  }
  .ss-auth-subtitle { font-size: 13.5px; color: #6B5B53; margin: 0; }
  .ss-auth-form { display: flex; flex-direction: column; gap: 16px; }
  .ss-auth-field-group { display: flex; flex-direction: column; gap: 6px; }
  .ss-auth-label { font-size: 13px; font-weight: 600; color: var(--ss-color-brown-dark, #3D1E0B); }
  .ss-auth-input {
    height: 44px; border: 1.5px solid #DED7CF; border-radius: 8px; padding: 0 14px;
    font-size: 14px; width: 100%; box-sizing: border-box; outline: none;
  }
  .ss-auth-input:focus { border-color: var(--ss-color-brown-dark, #3D1E0B); }
  .ss-auth-submit-btn {
    height: 46px; background-color: var(--ss-color-brown-dark, #3D1E0B); color: #FFFFFF;
    border: none; border-radius: 8px; font-size: 14.5px; font-weight: 600; cursor: pointer; margin-top: 6px;
  }
  .ss-auth-error-box { background: #FFF1F0; border: 1px solid #FFCCC7; color: #CF1322; padding: 12px; border-radius: 8px; font-size: 13px; }
</style>
