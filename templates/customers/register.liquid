{% comment %}
  SWAAD SAMVAAD - Ultra-Premium, Theme-Matched Customer Registration Template
  Handcrafted with authentic brand aesthetics, rich warm tones, and modern UX.
{% endcomment %}

<div class="ss-auth-page-wrapper">
  <!-- Brand Header -->
  <div class="ss-auth-brand-header">
    <a href="{{ routes.root_url }}" class="ss-auth-brand-link" aria-label="Swaad Samvaad Home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 220 | image_tag: class: 'ss-auth-brand-logo-img', alt: shop.name }}
      {%- else -%}
        <div class="ss-auth-brand-badge">
          <span>SS</span>
        </div>
        <span class="ss-auth-brand-name">SWAAD SAMVAAD</span>
      {%- endif -%}
    </a>
    <p class="ss-auth-brand-tagline">Artisanal Mithila Delicacies • 100% Pure Desi Ghee</p>
  </div>

  <div class="ss-auth-container">
    <div id="CustomerRegisterForm" class="ss-auth-card">
      <!-- Interactive Segmented Tabs -->
      <div class="ss-auth-nav-tabs">
        <a href="{{ routes.account_login_url }}" class="ss-auth-tab">Sign In</a>
        <a href="{{ routes.account_register_url }}" class="ss-auth-tab is-active" aria-current="page">Create Account</a>
      </div>

      <div class="ss-auth-header">
        <h1 class="ss-auth-title">Create an Account</h1>
        <p class="ss-auth-subtitle">Join us to enjoy express ordering, track fresh batches & unlock exclusive delicacies.</p>
      </div>

      <!-- Continue with Shop Option -->
      <a href="/services/login_with_shop/authorize?locale={{ request.locale.iso_code }}" class="ss-auth-shop-btn" aria-label="Continue with Shop">
        <span class="ss-auth-shop-text">Continue with</span>
        <span class="ss-auth-shop-logo">shop</span>
      </a>

      <!-- Clean Divider -->
      <div class="ss-auth-divider">
        <span>or register with email</span>
      </div>

      {% form 'create_customer', class: 'ss-auth-form' %}
        {% if form.errors %}
          <div class="ss-auth-error-box" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="ss-auth-alert-icon">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {% endif %}

        <!-- First & Last Name in 2-column Grid -->
        <div class="ss-auth-row">
          <div class="ss-auth-field-group">
            <label for="RegisterFirstName" class="ss-auth-label">First Name</label>
            <div class="ss-auth-input-wrapper">
              <span class="ss-auth-field-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </span>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterFirstName"
                class="ss-auth-input"
                {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                autocomplete="given-name"
                placeholder="First name"
                required
              >
            </div>
          </div>

          <div class="ss-auth-field-group">
            <label for="RegisterLastName" class="ss-auth-label">Last Name</label>
            <div class="ss-auth-input-wrapper">
              <span class="ss-auth-field-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </span>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterLastName"
                class="ss-auth-input"
                {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                autocomplete="family-name"
                placeholder="Last name"
                required
              >
            </div>
          </div>
        </div>

        <!-- Email Field -->
        <div class="ss-auth-field-group">
          <label for="RegisterEmail" class="ss-auth-label">Email Address</label>
          <div class="ss-auth-input-wrapper">
            <span class="ss-auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </span>
            <input
              type="email"
              name="customer[email]"
              id="RegisterEmail"
              class="ss-auth-input"
              {% if form.email %}value="{{ form.email }}"{% endif %}
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="name@example.com"
              required
            >
          </div>
        </div>

        <!-- Password Field with Toggle -->
        <div class="ss-auth-field-group">
          <label for="RegisterPassword" class="ss-auth-label">Password</label>
          <div class="ss-auth-input-wrapper">
            <span class="ss-auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </span>
            <input
              type="password"
              name="customer[password]"
              id="RegisterPassword"
              class="ss-auth-input"
              autocomplete="new-password"
              placeholder="Min 6 characters"
              required
            >
            <button type="button" class="ss-auth-toggle-pwd" aria-label="Toggle password visibility" data-target="RegisterPassword">
              <svg class="ss-pwd-show" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="ss-pwd-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="display: none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <label class="ss-auth-checkbox-label">
          <input type="checkbox" name="customer[accepts_marketing]" checked="checked" />
          <span>Subscribe to Swaad Samvaad alerts for fresh festival batches & recipes</span>
        </label>

        <button type="submit" class="ss-auth-submit-btn">
          <span>Create My Account</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="ss-btn-arrow">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <div class="ss-auth-footer-prompt">
          <span>Already have an account?</span>
          <a href="{{ routes.account_login_url }}" class="ss-auth-register-text-link">Sign in</a>
        </div>
      {% endform %}

      <!-- Trust Badges Strip -->
      <div class="ss-auth-trust-strip">
        <div class="ss-auth-trust-item">
          <span class="ss-trust-icon">🌿</span>
          <span class="ss-trust-text">Pure Desi Ghee</span>
        </div>
        <div class="ss-auth-trust-item">
          <span class="ss-trust-icon">📦</span>
          <span class="ss-trust-text">Fresh Batch Orders</span>
        </div>
        <div class="ss-auth-trust-item">
          <span class="ss-trust-icon">🔒</span>
          <span class="ss-trust-text">100% Secure</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Assistance & Policies -->
  <div class="ss-auth-page-footer">
    <div class="ss-auth-whatsapp-box">
      <span>Need instant assistance?</span>
      <a href="https://wa.me/919934444444?text={{ 'Hello Swaad Samvaad team, I need help registering my account.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="ss-auth-wa-link">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/>
        </svg>
        <span>Chat on WhatsApp</span>
      </a>
    </div>

    <div class="ss-auth-footer-legal-links">
      <a href="{{ routes.root_url }}">Return to Store</a>
      <span class="ss-dot">•</span>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <span class="ss-dot">•</span>
      <a href="/policies/terms-of-service">Terms of Service</a>
    </div>
  </div>
</div>

<style>
  /* Base Auth Page */
  .ss-auth-page-wrapper {
    min-height: 84vh;
    background: radial-gradient(circle at 50% 0%, #FFFDF9 0%, #F8F4EE 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 44px 20px 36px 20px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-sizing: border-box;
    color: #2B2523;
  }

  /* Brand Header */
  .ss-auth-brand-header {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ss-auth-brand-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .ss-auth-brand-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3D1E0B 0%, #5D331A 100%);
    border: 2px solid #C69C6D;
    color: #FAF6F0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 1px;
    box-shadow: 0 4px 14px rgba(61, 30, 11, 0.18);
  }

  .ss-auth-brand-name {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 21px;
    font-weight: 800;
    color: #3D1E0B;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .ss-auth-brand-tagline {
    font-size: 13px;
    color: #7D7067;
    margin: 5px 0 0 0;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  /* Auth Container & Card */
  .ss-auth-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .ss-auth-card {
    background: #FFFFFF;
    border: 1px solid rgba(198, 156, 109, 0.28);
    border-radius: 20px;
    padding: 32px 30px 28px 30px;
    box-shadow: 0 20px 60px rgba(61, 30, 11, 0.08), 0 2px 10px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
    position: relative;
  }

  /* Segmented Nav Tabs */
  .ss-auth-nav-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #FAF7F2;
    border: 1px solid #ECE4DA;
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 24px;
    gap: 4px;
  }

  .ss-auth-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    color: #6E6157;
    transition: all 0.2s ease;
  }

  .ss-auth-tab.is-active {
    background: #3D1E0B;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(61, 30, 11, 0.2);
  }

  .ss-auth-tab:not(.is-active):hover {
    color: #3D1E0B;
    background: rgba(198, 156, 109, 0.12);
  }

  /* Card Header */
  .ss-auth-header {
    text-align: left;
    margin-bottom: 20px;
  }

  .ss-auth-title {
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #24140B;
    margin: 0 0 6px 0;
    letter-spacing: -0.3px;
  }

  .ss-auth-subtitle {
    font-size: 13.5px;
    color: #7A6E66;
    margin: 0;
    line-height: 1.45;
  }

  /* Continue with Shop Button */
  .ss-auth-shop-btn {
    background-color: #5A31F4;
    color: #FFFFFF;
    border-radius: 10px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    width: 100%;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(90, 49, 244, 0.26);
    box-sizing: border-box;
  }

  .ss-auth-shop-btn:hover {
    background-color: #4820D9;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(90, 49, 244, 0.35);
  }

  .ss-auth-shop-text {
    font-size: 14.5px;
    font-weight: 600;
  }

  .ss-auth-shop-logo {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  /* Divider */
  .ss-auth-divider {
    display: flex;
    align-items: center;
    margin: 20px 0 18px 0;
    text-align: center;
    color: #94887F;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .ss-auth-divider::before,
  .ss-auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #EBE5DD;
  }

  .ss-auth-divider span {
    padding: 0 12px;
  }

  /* Fields & Inputs */
  .ss-auth-form {
    margin: 0;
  }

  .ss-auth-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .ss-auth-field-group {
    margin-bottom: 16px;
  }

  .ss-auth-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #382D26;
    margin-bottom: 6px;
  }

  .ss-auth-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ss-auth-field-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: #9C8F85;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ss-auth-field-icon svg {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }

  .ss-auth-input {
    width: 100%;
    height: 48px;
    border: 1.5px solid #E2D9CE;
    border-radius: 10px;
    padding: 0 14px 0 42px;
    font-size: 14.5px;
    color: #24140B;
    background: #FAF8F5;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: inherit;
  }

  .ss-auth-input:focus {
    background: #FFFFFF;
    border-color: #3D1E0B;
    box-shadow: 0 0 0 3px rgba(198, 156, 109, 0.25);
  }

  .ss-auth-input::placeholder {
    color: #A3968C;
  }

  /* Password Toggle Button */
  .ss-auth-toggle-pwd {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    color: #8C7F75;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.2s ease;
  }

  .ss-auth-toggle-pwd:hover {
    color: #3D1E0B;
  }

  .ss-auth-toggle-pwd svg {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  /* Checkbox */
  .ss-auth-checkbox-label {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 14px 0 20px 0;
    font-size: 13px;
    color: #554A42;
    cursor: pointer;
    user-select: none;
    line-height: 1.4;
  }

  .ss-auth-checkbox-label input[type="checkbox"] {
    width: 17px;
    height: 17px;
    accent-color: #3D1E0B;
    border-radius: 4px;
    cursor: pointer;
    margin: 0;
    flex-shrink: 0;
  }

  /* Submit Button */
  .ss-auth-submit-btn {
    width: 100%;
    height: 50px;
    background: linear-gradient(135deg, #3D1E0B 0%, #5D331A 100%);
    color: #FAF6F0;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.25s ease;
    box-shadow: 0 6px 18px rgba(61, 30, 11, 0.22);
    font-family: inherit;
    letter-spacing: 0.2px;
  }

  .ss-auth-submit-btn:hover {
    background: linear-gradient(135deg, #2A1407 0%, #462512 100%);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(61, 30, 11, 0.32);
    color: #FFFFFF;
  }

  .ss-btn-arrow {
    width: 18px;
    height: 18px;
    stroke-width: 2.2;
    transition: transform 0.2s ease;
  }

  .ss-auth-submit-btn:hover .ss-btn-arrow {
    transform: translateX(3px);
  }

  /* Prompts & Bottom Links */
  .ss-auth-footer-prompt {
    text-align: center;
    margin-top: 18px;
    font-size: 13px;
    color: #6E6157;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .ss-auth-register-text-link {
    color: #3D1E0B;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .ss-auth-register-text-link:hover {
    color: #C69C6D;
  }

  /* Trust Strip */
  .ss-auth-trust-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #ECE5DD;
    text-align: center;
  }

  .ss-auth-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ss-trust-icon {
    font-size: 16px;
  }

  .ss-trust-text {
    font-size: 11.5px;
    font-weight: 600;
    color: #6E6157;
  }

  /* Alerts */
  .ss-auth-error-box {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.4;
    margin-bottom: 18px;
    background: #FFF5F5;
    border: 1px solid #F8D7DA;
    color: #B02A37;
  }

  .ss-auth-alert-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    stroke-width: 2;
    margin-top: 1px;
  }

  /* Page Footer */
  .ss-auth-page-footer {
    text-align: center;
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .ss-auth-whatsapp-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #E6DCD1;
    border-radius: 24px;
    padding: 6px 14px;
    font-size: 13px;
    color: #554A42;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  .ss-auth-wa-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #128C7E;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ss-auth-wa-link:hover {
    opacity: 0.85;
  }

  .ss-auth-wa-link svg {
    width: 16px;
    height: 16px;
    fill: #25D366;
  }

  .ss-auth-footer-legal-links {
    font-size: 12.5px;
    color: #8C8077;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ss-auth-footer-legal-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ss-auth-footer-legal-links a:hover {
    color: #3D1E0B;
    text-decoration: underline;
  }

  .ss-dot {
    opacity: 0.6;
  }

  /* Responsive Adjustments */
  @media (max-width: 500px) {
    .ss-auth-page-wrapper {
      padding: 28px 16px 24px 16px;
    }
    .ss-auth-card {
      padding: 24px 18px 22px 18px;
      border-radius: 16px;
    }
    .ss-auth-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ss-auth-title {
      font-size: 21px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleBtns = document.querySelectorAll('.ss-auth-toggle-pwd');
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        const showIcon = this.querySelector('.ss-pwd-show');
        const hideIcon = this.querySelector('.ss-pwd-hide');
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            showIcon.style.display = 'none';
            hideIcon.style.display = 'block';
          } else {
            input.type = 'password';
            showIcon.style.display = 'block';
            hideIcon.style.display = 'none';
          }
        }
      });
    });
  });
</script>
